module

public import Pilean.PiFormula.TheoremE

/-!
# The cheapest checked computation of `π` with two formulas: the costs and the checker

Takahashi (Ramanujan J. 51 (2020), 177-186) computes hexadecimal digits of `π` with one
BBP-type formula and checks them with a second formula that shares most of its series,
instead of running one formula twice at shifted positions.

In the class F this is a question about zero relations. Let `ρ₁`, `ρ₂` be two patterns whose
series have the same non-zero value. A wrong value of one residue-class sum changes the two
results differently exactly at the positions where `ρ₁ k ≠ ρ₂ k`. A series on which the two
formulas agree therefore has to be computed twice. `pairCost ρ₁ ρ₂` counts, per period of 120
(60 bits), one for each position where one of the two patterns has a term, and one more where
both have the same non-zero term.

The theorems are in `CheckedPair.lean` (Theorem J): `60 ≤ pairCost ρ₁ ρ₂` for any two different
patterns of the class F with the same non-zero rational multiple of `π` as value
(`pairCost_ge`, from Baker's theorem), and Takahashi's pair attains 60 (`pairCost_takahashi`).
This file has the definitions and the verified checker behind the bound.

With `z = ρ₁ - ρ₂`, a zero relation, the cost is the number of positions where `z` has a term
plus twice the number of positions where `ρ₁` has a term and `z` has none (`zCost`,
`pairCost_eq_zCost`). The proof is a search tree on the 35 classes of positions, for `z` and
for `ρ₁`, checked by a verified checker as in `FewestTerms.lean`:

* a certificate (`PCert`) is a tree; `brW i` and `brQ i` split on "class `i` vanishes or not"
  for `z` and for `ρ₁`; `zeroW`, `nzW`, `nzQ` derive that a class vanishes or cannot vanish
  from an integer linear identity; `dead` closes a branch where every class of `z` vanishes;
  `done` counts `(classes where z is known not to vanish) + 2 (classes where z vanishes and
  ρ₁ is known not to)` and needs at least 60;
* `checkPair` checks a certificate by integer arithmetic, and `checkPair_sound` proves that a
  certificate that passes gives the bound;
* the certificate is generated by scripts/pairgen.py and checked by `decide +kernel`, in
  pieces. The files `CheckedPairCert1.lean`, `CheckedPairCert2.lean`, ... hold closed subtrees
  of bounded size, each checked on its own, with the lists of classes that the checker has
  collected on the way down to it. `checkPair_brW_ok` and `checkPair_brQ_ok` put the pieces
  together along the branches above them (`pairCert_ok` in `CheckedPair.lean`).

Why in pieces: the kernel gives back the memory of a computation only when the declaration is
finished. One `decide +kernel` on the whole tree needs more than 22 GB; piece by piece, a few
GB are enough for each file.
-/

@[expose] public section

open Complex

namespace PiFormula

/-! ## 1. The two costs -/

/-- The cost of computing with `ρ₁` and checking with `ρ₂`, per period of 120: one for each
position where one of the two patterns has a term, and one more where both have the same
non-zero term. -/
def pairCost (ρ₁ ρ₂ : ℕ → ℚ) : ℕ :=
  ((List.range 120).countP fun k => decide (ρ₁ k ≠ 0 ∨ ρ₂ k ≠ 0)) +
    ((List.range 120).countP fun k => decide (ρ₁ k ≠ 0 ∧ ρ₁ k = ρ₂ k))

/-- The same cost in terms of the zero relation `z = ρ₁ - ρ₂` and `ρ = ρ₁`: one for each
position where `z` has a term, two for each position where `ρ` has a term and `z` has none. -/
def zCost (z ρ : ℕ → ℚ) : ℕ :=
  ((List.range 120).countP fun k => decide (z k ≠ 0)) +
    2 * ((List.range 120).countP fun k => decide (z k = 0 ∧ ρ k ≠ 0))

theorem countP_add_eq {α : Type*} (A B C D : α → Bool)
    (h : ∀ a, (A a).toNat + (B a).toNat = (C a).toNat + 2 * (D a).toNat) (l : List α) :
    l.countP A + l.countP B = l.countP C + 2 * l.countP D := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha := h a
    simp only [List.countP_cons]
    cases hA : A a <;> cases hB : B a <;> cases hC : C a <;> cases hD : D a <;>
      simp only [hA, hB, hC, hD, Bool.toNat_true, Bool.toNat_false] at ha <;>
      simp only [Bool.false_eq_true, ↓reduceIte] <;> omega

theorem pairCost_eq_zCost (ρ₁ ρ₂ : ℕ → ℚ) :
    pairCost ρ₁ ρ₂ = zCost (fun k => ρ₁ k - ρ₂ k) ρ₁ := by
  refine countP_add_eq _ _ _ _ (fun k => ?_) _
  by_cases h1 : ρ₁ k = ρ₂ k <;> by_cases h2 : ρ₁ k = 0
  · have h3 : ρ₂ k = 0 := h1 ▸ h2
    simp [h2, h3]
  · have h3 : ρ₂ k ≠ 0 := h1 ▸ h2
    simp [h1, h3]
  · have h3 : ρ₂ k ≠ 0 := fun h => h1 (h2.trans h.symm)
    simp [h2, h3]
  · have h3 : ρ₁ k - ρ₂ k ≠ 0 := sub_ne_zero.2 h1
    simp [h1, h2, h3]

/-! ## 2. Certificates and the checker -/

/-- A certificate tree for a lower bound on `zCost`. -/
inductive PCert where
  | done : PCert
  | dead : PCert
  | zeroW (j : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) (rest : PCert) : PCert
  | nzW (j tgt : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) (rest : PCert) : PCert
  | nzQ (j tgt : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) (rest : PCert) : PCert
  | brW (i : ℕ) (zero nz : PCert) : PCert
  | brQ (i : ℕ) (zero nz : PCert) : PCert

/-- The integer identity `d · target = ∑ c · (vector)`, where the index 35 stands for the
value form `q 0 + q 2` on both sides. -/
def certEqV (tgt : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) : Bool :=
  (List.range 8).all fun t => d * tgtVec tgt t == (cs.map fun p => p.2 * tgtVec p.1 t).sum

/-- The checker. `Zw`, `Dw` list the classes where the zero relation is assumed to vanish and
known not to vanish; `Zq`, `Dq` the same for the formula. -/
def checkPair : List ℕ → List ℕ → List ℕ → List ℕ → PCert → Bool
  | Zw, Dw, _, Dq, .done =>
      decide (60 ≤ (clsIdxTab.countP fun i => Dw.contains i) +
        2 * (clsIdxTab.countP fun i => Zw.contains i && Dq.contains i))
  | Zw, _, _, _, .dead => (List.range 35).all fun i => Zw.contains i
  | Zw, Dw, Zq, Dq, .zeroW j d cs rest =>
      (d != 0) && (cs.all fun p => p.1 == 35 || Zw.contains p.1) && certEqV j d cs
        && checkPair (j :: Zw) Dw Zq Dq rest
  | Zw, Dw, Zq, Dq, .nzW j tgt d cs rest =>
      (d != 0) && (tgt != 35) && Dw.contains tgt
        && (cs.all fun p => p.1 == j || p.1 == 35 || Zw.contains p.1) && certEqV tgt d cs
        && checkPair Zw (j :: Dw) Zq Dq rest
  | Zw, Dw, Zq, Dq, .nzQ j tgt d cs rest =>
      (d != 0) && (tgt == 35 || Dq.contains tgt) && (cs.all fun p => p.1 == j || Zq.contains p.1)
        && certEq tgt d cs && checkPair Zw Dw Zq (j :: Dq) rest
  | Zw, Dw, Zq, Dq, .brW i t0 t1 =>
      checkPair (i :: Zw) Dw Zq Dq t0 && checkPair Zw (i :: Dw) Zq Dq t1
  | Zw, Dw, Zq, Dq, .brQ i t0 t1 =>
      checkPair Zw Dw (i :: Zq) Dq t0 && checkPair Zw Dw Zq (i :: Dq) t1

/-- A branch on the zero relation passes the checker if both sides pass. With this the
certificate is checked in pieces. -/
theorem checkPair_brW_ok {Zw Dw Zq Dq : List ℕ} {i : ℕ} {t0 t1 : PCert}
    (h0 : checkPair (i :: Zw) Dw Zq Dq t0 = true)
    (h1 : checkPair Zw (i :: Dw) Zq Dq t1 = true) :
    checkPair Zw Dw Zq Dq (.brW i t0 t1) = true := by
  simp only [checkPair, Bool.and_eq_true]
  exact ⟨h0, h1⟩

/-- A branch on the formula passes the checker if both sides pass. -/
theorem checkPair_brQ_ok {Zw Dw Zq Dq : List ℕ} {i : ℕ} {t0 t1 : PCert}
    (h0 : checkPair Zw Dw (i :: Zq) Dq t0 = true)
    (h1 : checkPair Zw Dw Zq (i :: Dq) t1 = true) :
    checkPair Zw Dw Zq Dq (.brQ i t0 t1) = true := by
  simp only [checkPair, Bool.and_eq_true]
  exact ⟨h0, h1⟩

/-! ## 3. Soundness -/

theorem lin8_sumV (cs : List (ℕ × ℤ)) (q : Fin 8 → ℚ) :
    lin8 (fun t => (cs.map fun p => p.2 * tgtVec p.1 t).sum) q =
      (cs.map fun p => (p.2 : ℚ) * tgtForm p.1 q).sum := by
  induction cs with
  | nil => simp [lin8]
  | cons p cs ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [← ih]
    simp only [lin8, tgtForm]
    push_cast
    ring

/-- A certificate identity with value forms that passes the check holds for the forms. -/
theorem certEqV_sound {tgt : ℕ} {d : ℤ} {cs : List (ℕ × ℤ)} (h : certEqV tgt d cs = true)
    (q : Fin 8 → ℚ) :
    (d : ℚ) * tgtForm tgt q = (cs.map fun p => (p.2 : ℚ) * tgtForm p.1 q).sum := by
  rw [← lin8_sumV]
  have h8 : ∀ t < 8, d * tgtVec tgt t = (cs.map fun p => p.2 * tgtVec p.1 t).sum := by
    intro t ht
    have h1 := List.all_eq_true.1 h t (List.mem_range.2 ht)
    exact eq_of_beq h1
  rw [← lin8_congr h8 q]
  simp only [tgtForm, lin8]
  push_cast
  ring

/-- The form of an index, for a vector on which the value form vanishes. -/
theorem tgtForm_eq_zero_of {w : Fin 8 → ℚ} (hw0 : w 0 + w 2 = 0) {i : ℕ}
    (h : i = 35 ∨ clsForm i w = 0) : tgtForm i w = 0 := by
  by_cases e : i = 35
  · rw [e, tgtForm_35]
    exact hw0
  · rw [tgtForm_of_ne e]
    exact h.resolve_left e

theorem clsIdx_le (k : ℕ) : clsIdx k ≤ 35 := by
  have h : ∀ r < 120, clsIdxTab.getD r 35 ≤ 35 := by decide +kernel
  exact h (k % 120) (Nat.mod_lt _ (by norm_num))

/-- **The checker is sound.** If a certificate passes, then for every zero relation
`namedComb w ≠ 0` and every pattern `namedComb q` of non-zero value, with the classes in `Zw`,
`Zq` vanishing and those in `Dw`, `Dq` not, the cost is at least 60. -/
theorem checkPair_sound (w q : Fin 8 → ℚ) (hw0 : w 0 + w 2 = 0)
    (hw : ∃ k, namedComb w k ≠ 0) (hq : q 0 + q 2 ≠ 0) :
    ∀ (c : PCert) (Zw Dw Zq Dq : List ℕ), checkPair Zw Dw Zq Dq c = true →
    (∀ z ∈ Zw, clsForm z w = 0) → (∀ e ∈ Dw, clsForm e w ≠ 0) →
    (∀ z ∈ Zq, clsForm z q = 0) → (∀ e ∈ Dq, clsForm e q ≠ 0) →
    60 ≤ zCost (namedComb w) (namedComb q) := by
  intro c
  induction c with
  | done =>
    intro Zw Dw Zq Dq h hZw hDw _ hDq
    have h1 : 60 ≤ (clsIdxTab.countP fun i => Dw.contains i) +
        2 * (clsIdxTab.countP fun i => Zw.contains i && Dq.contains i) := of_decide_eq_true h
    rw [clsIdxTab_eq, List.countP_map, List.countP_map] at h1
    refine h1.trans (Nat.add_le_add (List.countP_mono_left fun k _ hk => ?_)
      (Nat.mul_le_mul_left 2 (List.countP_mono_left fun k _ hk => ?_)))
    · have hmem : clsIdx k ∈ Dw := List.elem_iff.1 hk
      have hne : namedComb w k ≠ 0 := fun h0 => hDw _ hmem ((namedComb_eq_zero_iff w k).1 h0)
      exact decide_eq_true hne
    · have hk' : (Zw.contains (clsIdx k) && Dq.contains (clsIdx k)) = true := hk
      rw [Bool.and_eq_true] at hk'
      have hz : namedComb w k = 0 :=
        (namedComb_eq_zero_iff w k).2 (hZw _ (List.elem_iff.1 hk'.1))
      have hne : namedComb q k ≠ 0 := fun h0 =>
        hDq _ (List.elem_iff.1 hk'.2) ((namedComb_eq_zero_iff q k).1 h0)
      exact decide_eq_true ⟨hz, hne⟩
  | dead =>
    intro Zw Dw Zq Dq h hZw _ _ _
    exfalso
    obtain ⟨k, hk⟩ := hw
    refine hk ((namedComb_eq_zero_iff w k).2 ?_)
    rcases Nat.lt_or_ge (clsIdx k) 35 with hlt | hge
    · have h1 := List.all_eq_true.1 h (clsIdx k) (List.mem_range.2 hlt)
      exact hZw _ (List.elem_iff.1 h1)
    · rw [le_antisymm (clsIdx_le k) hge]
      exact clsForm_35 w
  | zeroW j d cs rest ih =>
    intro Zw Dw Zq Dq h hZw hDw hZq hDq
    simp only [checkPair, Bool.and_eq_true] at h
    obtain ⟨⟨⟨hd, hcs⟩, heq⟩, hrest⟩ := h
    have hd' : (d : ℚ) ≠ 0 := by
      have h0 : d ≠ 0 := by simpa using hd
      exact_mod_cast h0
    have hsum : (cs.map fun p => (p.2 : ℚ) * tgtForm p.1 w).sum = 0 := by
      refine List.sum_eq_zero fun x hx => ?_
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
      have hp1 := List.all_eq_true.1 hcs p hp
      have hp0 : tgtForm p.1 w = 0 := by
        refine tgtForm_eq_zero_of hw0 ?_
        rcases Bool.or_eq_true_iff.1 hp1 with h1 | h1
        · exact Or.inl (eq_of_beq h1)
        · exact Or.inr (hZw _ (List.elem_iff.1 h1))
      rw [hp0, mul_zero]
    have h2 := certEqV_sound heq w
    rw [hsum] at h2
    have h3 : tgtForm j w = 0 := (mul_eq_zero.1 h2).resolve_left hd'
    have hj : clsForm j w = 0 := by
      by_cases e : j = 35
      · rw [e]
        exact clsForm_35 w
      · rwa [tgtForm_of_ne e] at h3
    refine ih (j :: Zw) Dw Zq Dq hrest (fun z hz => ?_) hDw hZq hDq
    rcases List.mem_cons.1 hz with rfl | hz
    · exact hj
    · exact hZw z hz
  | nzW j tgt d cs rest ih =>
    intro Zw Dw Zq Dq h hZw hDw hZq hDq
    simp only [checkPair, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨⟨hd, htgt35⟩, htgt⟩, hcs⟩, heq⟩, hrest⟩ := h
    have hd' : (d : ℚ) ≠ 0 := by
      have h0 : d ≠ 0 := by simpa using hd
      exact_mod_cast h0
    have ht35 : tgt ≠ 35 := by simpa using htgt35
    have hj : clsForm j w ≠ 0 := by
      intro hj0
      have hsum : (cs.map fun p => (p.2 : ℚ) * tgtForm p.1 w).sum = 0 := by
        refine List.sum_eq_zero fun x hx => ?_
        obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
        have hp1 := List.all_eq_true.1 hcs p hp
        have hp0 : tgtForm p.1 w = 0 := by
          refine tgtForm_eq_zero_of hw0 ?_
          rcases Bool.or_eq_true_iff.1 hp1 with h1 | h1
          · rcases Bool.or_eq_true_iff.1 h1 with h1 | h1
            · rw [eq_of_beq h1]
              exact Or.inr hj0
            · exact Or.inl (eq_of_beq h1)
          · exact Or.inr (hZw _ (List.elem_iff.1 h1))
        rw [hp0, mul_zero]
      have h2 := certEqV_sound heq w
      rw [hsum] at h2
      have h3 : tgtForm tgt w = 0 := (mul_eq_zero.1 h2).resolve_left hd'
      rw [tgtForm_of_ne ht35] at h3
      exact hDw _ (List.elem_iff.1 htgt) h3
    refine ih Zw (j :: Dw) Zq Dq hrest hZw (fun e he => ?_) hZq hDq
    rcases List.mem_cons.1 he with rfl | he
    · exact hj
    · exact hDw e he
  | nzQ j tgt d cs rest ih =>
    intro Zw Dw Zq Dq h hZw hDw hZq hDq
    simp only [checkPair, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨hd, htgt⟩, hcs⟩, heq⟩, hrest⟩ := h
    have hd' : (d : ℚ) ≠ 0 := by
      have h0 : d ≠ 0 := by simpa using hd
      exact_mod_cast h0
    have hj : clsForm j q ≠ 0 := by
      intro hj0
      have hsum : (cs.map fun p => (p.2 : ℚ) * clsForm p.1 q).sum = 0 := by
        refine List.sum_eq_zero fun x hx => ?_
        obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
        have hp1 := List.all_eq_true.1 hcs p hp
        have hp0 : clsForm p.1 q = 0 := by
          rcases Bool.or_eq_true_iff.1 hp1 with h1 | h1
          · rw [eq_of_beq h1]
            exact hj0
          · exact hZq _ (List.elem_iff.1 h1)
        rw [hp0, mul_zero]
      have h2 := certEq_sound heq q
      rw [hsum] at h2
      have h3 : tgtForm tgt q = 0 := (mul_eq_zero.1 h2).resolve_left hd'
      by_cases e : tgt = 35
      · rw [e, tgtForm_35] at h3
        exact hq h3
      · rw [tgtForm_of_ne e] at h3
        rcases Bool.or_eq_true_iff.1 htgt with h4 | h4
        · exact e (eq_of_beq h4)
        · exact hDq _ (List.elem_iff.1 h4) h3
    refine ih Zw Dw Zq (j :: Dq) hrest hZw hDw hZq fun e he => ?_
    rcases List.mem_cons.1 he with rfl | he
    · exact hj
    · exact hDq e he
  | brW i t0 t1 ih0 ih1 =>
    intro Zw Dw Zq Dq h hZw hDw hZq hDq
    simp only [checkPair, Bool.and_eq_true] at h
    obtain ⟨h0, h1⟩ := h
    by_cases hi : clsForm i w = 0
    · refine ih0 (i :: Zw) Dw Zq Dq h0 (fun z hz => ?_) hDw hZq hDq
      rcases List.mem_cons.1 hz with rfl | hz
      · exact hi
      · exact hZw z hz
    · refine ih1 Zw (i :: Dw) Zq Dq h1 hZw (fun e he => ?_) hZq hDq
      rcases List.mem_cons.1 he with rfl | he
      · exact hi
      · exact hDw e he
  | brQ i t0 t1 ih0 ih1 =>
    intro Zw Dw Zq Dq h hZw hDw hZq hDq
    simp only [checkPair, Bool.and_eq_true] at h
    obtain ⟨h0, h1⟩ := h
    by_cases hi : clsForm i q = 0
    · refine ih0 Zw Dw (i :: Zq) Dq h0 hZw hDw (fun z hz => ?_) hDq
      rcases List.mem_cons.1 hz with rfl | hz
      · exact hi
      · exact hZq z hz
    · refine ih1 Zw Dw Zq (i :: Dq) h1 hZw hDw hZq fun e he => ?_
      rcases List.mem_cons.1 he with rfl | he
      · exact hi
      · exact hDq e he

