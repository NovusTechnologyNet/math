module

public import Pilean.PiFormula.TheoremC2

/-!
# Theorem D for rational multiples of π (milestone M8)

By `span_namedFam` (from Baker's theorem) every rational pattern whose series is a rational
multiple of `π` is a combination `namedComb q = ∑ q_i · named_i` of the eight named patterns
(`exists_coords`), and its value is `(q_0 + q_2) π/4` (`hasSum_namedComb`). Statements about
such patterns become linear algebra on `q ∈ ℚ^8`.

**Theorem D** (`theoremD`), for rational multiples of `π`: a series of the class F whose terms
all sit at `k` with `gcd(k, 120) ≥ 4` has value 0. So no formula for `π` in F is "uniformly
fast". (The note states Theorem D for algebraic multiples; that needs the full 13-dimensional
space and is not proved here.)

**The value formula** (`value_formula`) is sharper: the rational multiple is read off from
six terms, `(7ρ(1)/12 + ρ(2)/8 + ρ(3)/6 - 7ρ(7)/12 + ρ(9)/6 - ρ(14)/8) · π/4`.

Sections 2 and 3 are generated by lean/scripts/baileygen.py: values of `namedComb q` at
particular `k` (`decide +kernel`), and what each condition forces on `q`
(`linear_combination`). They are also used for Bailey's table in `Bailey.lean` and for the
sharp form of Theorem D in `SharpD.lean`.
-/

@[expose] public section

open Complex

namespace PiFormula

/-! ## 1. Coordinates in the eight named series -/

/-- The combination `∑ q_i · named_i` of the eight named patterns. -/
def namedComb (q : Fin 8 → ℚ) (k : ℕ) : ℚ :=
  q 0 * namedA1 k + q 1 * namedA6 k + q 2 * namedA10 k + q 3 * namedL6 k + q 4 * namedL8 k
    + q 5 * namedL10 k + q 6 * namedL24 k + q 7 * namedTW k

/-- **Coordinates (from Baker's theorem).** Every rational pattern of period `N` (a multiple of
120) whose series is a rational multiple of `π` is a combination of the eight named patterns. -/
theorem exists_coords (hB : BakerTheorem) {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) {ρ : ℕ → ℚ}
    (hρ : ρ ∈ ratSpace N) : ∃ q : Fin 8 → ℚ, ρ = namedComb q := by
  have hmem : (⟨ρ, hρ⟩ : ratSpace N) ∈ Submodule.span ℚ (Set.range (namedFam h120)) := by
    rw [span_namedFam hB hN h120]
    exact Submodule.mem_top
  obtain ⟨q, hq⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ).1 hmem
  refine ⟨q, ?_⟩
  have h1 : ((∑ i, q i • namedFam h120 i : ratSpace N) : ℕ → ℚ) = ρ := by rw [hq]
  rw [← h1]
  funext k
  simp only [Fin.sum_univ_eight, namedComb]
  rfl

theorem seriesTerm_namedComb (q : Fin 8 → ℚ) (k : ℕ) :
    seriesTerm (namedComb q) k =
      q 0 * seriesTerm namedA1 k + q 1 * seriesTerm namedA6 k + q 2 * seriesTerm namedA10 k
        + q 3 * seriesTerm namedL6 k + q 4 * seriesTerm namedL8 k
        + q 5 * seriesTerm namedL10 k + q 6 * seriesTerm namedL24 k
        + q 7 * seriesTerm namedTW k := by
  simp only [seriesTerm, namedComb]
  push_cast
  ring

/-- The value of a combination: `(q_0 + q_2) π/4`. -/
theorem hasSum_namedComb (q : Fin 8 → ℚ) :
    HasSum (seriesTerm (namedComb q)) (((q 0 + q 2 : ℚ) : ℝ) * (Real.pi / 4)) := by
  have h := (((((((hasSum_namedA1.mul_left (q 0 : ℝ)).add
    (hasSum_namedA6.mul_left (q 1 : ℝ))).add (hasSum_namedA10.mul_left (q 2 : ℝ))).add
    (hasSum_namedL6.mul_left (q 3 : ℝ))).add (hasSum_namedL8.mul_left (q 4 : ℝ))).add
    (hasSum_namedL10.mul_left (q 5 : ℝ))).add (hasSum_namedL24.mul_left (q 6 : ℝ))).add
    (hasSum_namedTW.mul_left (q 7 : ℝ))
  have e : seriesTerm (namedComb q) = fun k =>
      (q 0 : ℝ) * seriesTerm namedA1 k + q 1 * seriesTerm namedA6 k
        + q 2 * seriesTerm namedA10 k + q 3 * seriesTerm namedL6 k
        + q 4 * seriesTerm namedL8 k + q 5 * seriesTerm namedL10 k
        + q 6 * seriesTerm namedL24 k + q 7 * seriesTerm namedTW k :=
    funext (seriesTerm_namedComb q)
  rw [e]
  have ev : ((q 0 + q 2 : ℚ) : ℝ) * (Real.pi / 4) =
      (q 0 : ℝ) * (Real.pi / 4) + q 1 * 0 + q 2 * (Real.pi / 4) + q 3 * 0 + q 4 * 0 + q 5 * 0
        + q 6 * 0 + q 7 * 0 := by
    push_cast
    ring
  rw [ev]
  exact h

/-- A combination with value 0 has `q_0 + q_2 = 0`. -/
theorem coords_zero {q : Fin 8 → ℚ} (h : HasSum (seriesTerm (namedComb q)) 0) :
    q 0 + q 2 = 0 := by
  have h2 := (hasSum_namedComb q).unique h
  have hpi := Real.pi_pos
  have h3 : ((q 0 + q 2 : ℚ) : ℝ) = 0 := by
    rcases mul_eq_zero.1 h2 with h3 | h3
    · exact h3
    · linarith
  exact_mod_cast h3

