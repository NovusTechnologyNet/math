import Pilean.PiFormula.TheoremC2

/-!
# Five more series: irrational algebraic multiples of π (milestone M7, part 3)

The eight named series of `VSeries.lean` have rational values (in units of `π`). Here are five
more rational patterns of period 120 whose series are algebraic, irrational multiples of `π`:

| pattern | value | twist |
|---|---|---|
| `extraS3` | `-π/√3` | `√3`, roots of order 6 |
| `extraS2` | `-√2 π` | `√2`, roots of order 8 and 24 |
| `extraS5` | `-√5 π` | `√5`, roots of order 10 and 20 |
| `extraT1` | `(θ₁ - 3θ₃) π/5` | `θ₁ = 2cos(π/10)`, `θ₃ = 2cos(3π/10)`, roots of order 10 and 20 |
| `extraT2` | `(3θ₁ + θ₃) π/5` | the same, conjugated |

Each is an arctangent-type series `∑_j e_j arg(1 - ζ^j/t)` with real coefficients `e_j` in
`ℚ(ζ_120)`, conjugate under `ζ ↦ ζ^b` (`b ≡ 1 mod 4`), so that the power sums
`∑_j e_j ζ^(jk)` are Gaussian integers. The proof for each series has three steps:

1. the power sum equals a table of Gaussian integers (section 3, generated by
   scripts/fivegen.py: one certificate modulo `Φ_24` or `Φ_20` for each residue of `k`);
2. so the pattern is rational and its series is `∑_j e_j arg w_j` (`hasSum_rhoA_of_lsum`);
3. the exact arguments of `ExactArgs.lean` give the value.

With the eight named series these are thirteen independent patterns (`TheoremC3.lean`), so
the space of Theorem C has dimension exactly 13.
-/

open Complex

namespace PiFormula

/-! ## 1. Twisted power sums with real coefficients -/

/-- The power sum `∑ e (ζ_120^j)^k` of a list of pairs `(e, j)`. -/
noncomputable def lsum (L : List (ℝ × ℕ)) (k : ℕ) : ℂ :=
  (L.map fun p => (p.1 : ℂ) * (ζ120 ^ p.2) ^ k).sum

/-- The value `∑ e arg(1 - ζ_120^j / t)` of a list of pairs `(e, j)`. -/
noncomputable def lval (L : List (ℝ × ℕ)) : ℝ := (L.map fun p => p.1 * garg p.2).sum

theorem hasSum_lsum (L : List (ℝ × ℕ)) :
    HasSum (fun k : ℕ => -((lsum L k * tC⁻¹ ^ k).im / k)) (lval L) := by
  induction L with
  | nil =>
    simp only [lsum, lval, List.map_nil, List.sum_nil, zero_mul, Complex.zero_im, zero_div,
      neg_zero]
    exact hasSum_zero
  | cons p L ih =>
    have h1 := (hasSum_gfun (norm_ζ120_pow p.2)).mul_left p.1
    have h := h1.add ih
    have e : (fun k : ℕ => -((lsum (p :: L) k * tC⁻¹ ^ k).im / k)) = fun k : ℕ =>
        p.1 * -(((ζ120 ^ p.2) ^ k * tC⁻¹ ^ k).im / k) + -((lsum L k * tC⁻¹ ^ k).im / k) := by
      funext k
      have e1 : lsum (p :: L) k = (p.1 : ℂ) * (ζ120 ^ p.2) ^ k + lsum L k := by
        simp only [lsum, List.map_cons, List.sum_cons]
      rw [e1, add_mul, Complex.add_im, mul_assoc, Complex.im_ofReal_mul]
      ring
    have e2 : lval (p :: L) = p.1 * gfun (ζ120 ^ p.2) + lval L := by
      simp only [lval, List.map_cons, List.sum_cons, garg_eq_gfun]
    rw [e, e2]
    exact h

/-- If the power sum of `L` is the Gaussian-integer model `P`, the arctangent-type pattern of
`P` has the series `∑ e arg w_j`. -/
theorem hasSum_rhoA_of_lsum {L : List (ℝ × ℕ)} {P : ℕ → GaussianInt}
    (hP : ∀ k, lsum L k = ((P k : GaussianInt) : ℂ)) :
    HasSum (seriesTerm (rhoA P)) (lval L) := by
  have h := hasSum_lsum L
  have e : seriesTerm (rhoA P) = fun k : ℕ => -((lsum L k * tC⁻¹ ^ k).im / k) := by
    funext k
    rw [hP, mul_tC_inv_pow_im, seriesTerm, rhoA]
    push_cast
    ring
  rw [e]
  exact h

/-! ## 2. The real coefficients, as sums of roots of unity -/

theorem z20_pow_mod (n : ℕ) : z20 ^ n = z20 ^ (n % 20) := by
  conv_lhs => rw [← Nat.div_add_mod n 20, pow_add, pow_mul, z20_prim.pow_eq_one, one_pow, one_mul]

theorem ζ120_pow_trig (j : ℕ) :
    ζ120 ^ j = (Real.cos (Real.pi * j / 60) : ℂ) + (Real.sin (Real.pi * j / 60) : ℂ) * I := by
  rw [ζ120_pow_eq, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]

/-- `2 cos(2πj/120) = ζ_120^j + ζ_120^(120-j)`. -/
theorem two_cos_eq {j : ℕ} (hj : j ≤ 120) :
    ((2 * Real.cos (Real.pi * j / 60) : ℝ) : ℂ) = ζ120 ^ j + ζ120 ^ (120 - j) := by
  rw [ζ120_pow_trig j, ζ120_pow_trig (120 - j)]
  have e : Real.pi * ((120 - j : ℕ) : ℝ) / 60 = 2 * Real.pi - Real.pi * j / 60 := by
    rw [Nat.cast_sub hj]
    push_cast
    ring
  rw [e, Real.cos_two_pi_sub, Real.sin_two_pi_sub]
  push_cast
  ring

theorem sqrt3_eq : ((Real.sqrt 3 : ℝ) : ℂ) = z24 ^ 2 - z24 ^ 10 := dTW_eq.symm

theorem sqrt2_eq : ((Real.sqrt 2 : ℝ) : ℂ) = z24 ^ 3 + z24 ^ 21 := by
  have h : ((2 * Real.cos (Real.pi * ((15 : ℕ) : ℝ) / 60) : ℝ) : ℂ) = ζ120 ^ 15 + ζ120 ^ 105 :=
    two_cos_eq (j := 15) (by norm_num)
  have e : Real.pi * ((15 : ℕ) : ℝ) / 60 = Real.pi / 4 := by
    push_cast
    ring
  rw [e, Real.cos_pi_div_four] at h
  have e3 : z24 ^ 3 = ζ120 ^ 15 := by rw [z24, ← pow_mul]
  have e21 : z24 ^ 21 = ζ120 ^ 105 := by rw [z24, ← pow_mul]
  rw [e3, e21, ← h]
  congr 1
  ring

theorem cos_two_pi_div_five : Real.cos (2 * Real.pi / 5) = (Real.sqrt 5 - 1) / 4 := by
  have h := Real.cos_two_mul (Real.pi / 5)
  rw [Real.cos_pi_div_five] at h
  have e : 2 * (Real.pi / 5) = 2 * Real.pi / 5 := by ring
  rw [e] at h
  rw [h]
  have h5 : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num)
  linear_combination (1 / 8 : ℝ) * h5

theorem cos_four_pi_div_five : Real.cos (4 * Real.pi / 5) = -(1 + Real.sqrt 5) / 4 := by
  have e : 4 * Real.pi / 5 = Real.pi - Real.pi / 5 := by ring
  rw [e, Real.cos_pi_sub, Real.cos_pi_div_five]
  ring

theorem sqrt5_eq : ((Real.sqrt 5 : ℝ) : ℂ) = z20 ^ 4 - z20 ^ 8 - z20 ^ 12 + z20 ^ 16 := by
  have h1 : ((2 * Real.cos (Real.pi * ((24 : ℕ) : ℝ) / 60) : ℝ) : ℂ) = ζ120 ^ 24 + ζ120 ^ 96 :=
    two_cos_eq (j := 24) (by norm_num)
  have h2 : ((2 * Real.cos (Real.pi * ((48 : ℕ) : ℝ) / 60) : ℝ) : ℂ) = ζ120 ^ 48 + ζ120 ^ 72 :=
    two_cos_eq (j := 48) (by norm_num)
  have e1 : Real.pi * ((24 : ℕ) : ℝ) / 60 = 2 * Real.pi / 5 := by
    push_cast
    ring
  have e2 : Real.pi * ((48 : ℕ) : ℝ) / 60 = 4 * Real.pi / 5 := by
    push_cast
    ring
  rw [e1, cos_two_pi_div_five] at h1
  rw [e2, cos_four_pi_div_five] at h2
  have a4 : z20 ^ 4 = ζ120 ^ 24 := by rw [z20, ← pow_mul]
  have a8 : z20 ^ 8 = ζ120 ^ 48 := by rw [z20, ← pow_mul]
  have a12 : z20 ^ 12 = ζ120 ^ 72 := by rw [z20, ← pow_mul]
  have a16 : z20 ^ 16 = ζ120 ^ 96 := by rw [z20, ← pow_mul]
  have e : z20 ^ 4 - z20 ^ 8 - z20 ^ 12 + z20 ^ 16 =
      (ζ120 ^ 24 + ζ120 ^ 96) - (ζ120 ^ 48 + ζ120 ^ 72) := by
    rw [a4, a8, a12, a16]
    ring
  rw [e, ← h1, ← h2, ← Complex.ofReal_sub]
  congr 1
  ring

/-- `θ₁ = 2 cos(π/10)`. -/
noncomputable def th1 : ℝ := 2 * Real.cos (Real.pi / 10)

/-- `θ₃ = 2 cos(3π/10)`. -/
noncomputable def th3 : ℝ := 2 * Real.cos (3 * Real.pi / 10)

theorem th1_eq : (th1 : ℂ) = z20 + z20 ^ 19 := by
  have h : ((2 * Real.cos (Real.pi * ((6 : ℕ) : ℝ) / 60) : ℝ) : ℂ) = ζ120 ^ 6 + ζ120 ^ 114 :=
    two_cos_eq (j := 6) (by norm_num)
  have e : Real.pi * ((6 : ℕ) : ℝ) / 60 = Real.pi / 10 := by
    push_cast
    ring
  rw [e] at h
  have a19 : z20 ^ 19 = ζ120 ^ 114 := by rw [z20, ← pow_mul]
  rw [a19, th1, h, z20]

theorem th3_eq : (th3 : ℂ) = z20 ^ 3 + z20 ^ 17 := by
  have h : ((2 * Real.cos (Real.pi * ((18 : ℕ) : ℝ) / 60) : ℝ) : ℂ) = ζ120 ^ 18 + ζ120 ^ 102 :=
    two_cos_eq (j := 18) (by norm_num)
  have e : Real.pi * ((18 : ℕ) : ℝ) / 60 = 3 * Real.pi / 10 := by
    push_cast
    ring
  rw [e] at h
  have a3 : z20 ^ 3 = ζ120 ^ 18 := by rw [z20, ← pow_mul]
  have a17 : z20 ^ 17 = ζ120 ^ 102 := by rw [z20, ← pow_mul]
  rw [a3, a17, th3, h]

