/-!
# A general base `b`: the values that are logarithms lie in the span of the base numbers

`F_b` is the class of series `∑ ρ(k) b^(-⌊k/2⌋)/k` with `ρ` rational and periodic, and
`ν(r)² = c₀(r)² / b^(d(r))`, with `c₀(r)` and `d(r)` the constant term and the degree of the
minimal polynomial of `√b - r` over `ℤ` (`nuSq`, file `LogDefs`).

**Theorem** (`inBaseSpan_of_isFBValue`, from Baker's theorem). Let `b ≥ 2`. If
`q π + q' log y`, with `q, q'` rational, `q' ≠ 0` and `y` a positive rational number, is a value
of `F_b`, then some power `y^k`, `k ≥ 1`, is a product of integer powers of the numbers `ν(r)²`,
`r` over finitely many roots of unity.

The proof. Let `t = √b`.

1. (`exists_intRel_of_isFBValue`) The value is `∑ d_r Log(1 - r/t)` (`seriesTermB_hasSum_logs`),
   so by Baker's theorem the vector `(-q'; i q; d_r)` is a combination of integer relations
   among `log y`, `iπ` and the `Log(1 - r/t)` (`baker_descent`). As `q' ≠ 0`, one of them,
   `m log y + z₀ iπ + ∑ z_r Log(1 - r/t) = 0`, has `m ≠ 0`.
2. (`zpow_relation_of_intRel`) Twice this relation, exponentiated:
   `y^(2m) ∏ (1 - r/t)^(2 z_r) = 1`.
3. (`norm_zpow_relation`) Let `L` be the subfield of `ℂ` generated by `t` and the roots `r`,
   of degree `D` over `ℚ`. The norm from `L` to `ℚ` of the relation is
   `y^(2mD) ∏ (Norm(1 - r/t)²)^(z_r) = 1`, and `Norm(1 - r/t)² = ν(r)²^(m_r)` for a natural
   number `m_r` (`norm_one_sub_div_sq_eq_nuSq`, file `LogSpanAux`).
4. (`inBaseSpan_of_zpow`) So `y^(2mD) = ∏ ν(r)²^(-m_r z_r)` with `2mD ≠ 0`; if `m < 0`, take the
   inverses.
-/

@[expose] public section

open Complex Module

namespace PiFormula

namespace BaseB

/-! ## 1. An integer relation that involves `log y` -/

/-- **An integer relation with `log y`** (from Baker's theorem). If `q π + q' log y`, `q' ≠ 0`,
is a value of `F_b`, there is an integer relation
`m log y + z₀ iπ + ∑_{r ∈ S} z_r Log(1 - r/t) = 0` with `m ≠ 0`, over a finite set `S` of roots
of unity. -/
theorem exists_intRel_of_isFBValue (hB : BakerTheorem) {b : ℕ} (hb : 2 ≤ b) {q q' : ℚ}
    (hq' : q' ≠ 0) {y : ℚ} (hy : 0 < y)
    (h : IsFBValue b (q * Real.pi + q' * Real.log y)) :
    ∃ (S : Finset ℂ) (z : Option (Option ℂ) → ℤ), (∀ r ∈ S, IsOfFinOrder r) ∧ z none ≠ 0 ∧
      (z none : ℂ) * ((Real.log (y : ℝ) : ℝ) : ℂ) + ((z (some none) : ℂ) * (Real.pi * I) +
        ∑ r ∈ S, (z (some (some r)) : ℂ) * Complex.log (1 - r / tB b)) = 0 := by
  classical
  obtain ⟨N, ρ, hN, hρ, hsum⟩ := h
  -- an even period, and the series as a combination of logarithms
  have hρ2 : ∀ k, ρ (k + 2 * N) = ρ k := fun k => by
    have h2 := periodic_mul hρ 2 k
    rwa [mul_comm] at h2
  have hN2 : 0 < 2 * N := by positivity
  have hS : ∀ r ∈ rootsN (2 * N), IsOfFinOrder r := fun r hr =>
    isOfFinOrder_of_mem_rootsN hN2 hr
  have h1 := (seriesTermB_hasSum_logs hb hN2 (Dvd.intro N rfl) hρ2).unique
    (Complex.hasSum_ofReal.2 hsum)
  have hΛ : Complex.exp ((Real.log (y : ℝ) : ℝ) : ℂ) = (y : ℂ) := by
    rw [← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast hy)]
    push_cast
    rfl
  -- the coefficient vector
  let β : Option (Option ℂ) → ℂ := fun o =>
    match o with
    | none => -(q' : ℂ)
    | some none => I * q
    | some (some r) => if r ∈ rootsN (2 * N) then fourierDB b (2 * N) ρ r else 0
  have hβS : ∀ r ∈ rootsN (2 * N), β (some (some r)) = fourierDB b (2 * N) ρ r :=
    fun r hr => by simp only [β, hr, ↓reduceIte]
  have hF : ∀ x ∈ algebraicClosure ℚ ℂ, IsAlgebraic ℚ x := fun x hx =>
    mem_algebraicClosure_iff.1 hx
  have hspan : SpanIn (algebraicClosure ℚ ℂ)
      (IntRel (Finset.insertNone (Finset.insertNone (rootsN (2 * N))))
        (lamOfBY b ((Real.log (y : ℝ) : ℝ) : ℂ))) β := by
    refine baker_descent hB _ hF (lamOfBY b ((Real.log (y : ℝ) : ℝ) : ℂ)) _ ?_ β ?_ ?_ ?_
    · intro i hi
      rcases i with _ | _ | r
      · change IsAlgebraic ℚ (Complex.exp ((Real.log (y : ℝ) : ℝ) : ℂ))
        rw [hΛ]
        exact isAlgebraic_ratCast ℚ (A := ℂ) y
      · change IsAlgebraic ℚ (Complex.exp (Real.pi * I))
        rw [Complex.exp_pi_mul_I]
        exact isAlgebraic_one.neg
      · exact isAlgebraic_exp_log_wB hb
          (hS r (Finset.some_mem_insertNone.1 (Finset.some_mem_insertNone.1 hi)))
    · intro i hi
      rcases i with _ | _ | r
      · exact mem_algebraicClosure_iff.2 (isAlgebraic_ratCast ℚ (A := ℂ) q').neg
      · exact mem_algebraicClosure_iff.2 (isAlgebraic_I.mul (isAlgebraic_ratCast ℚ (A := ℂ) q))
      · have hr : r ∈ rootsN (2 * N) :=
          Finset.some_mem_insertNone.1 (Finset.some_mem_insertNone.1 hi)
        rw [hβS r hr]
        exact mem_algebraicClosure_iff.2 (isAlgebraic_fourierDB b (2 * N) ρ (hS r hr))
    · intro i hi
      rcases i with _ | _ | r
      · exact absurd (by simp) hi
      · exact absurd (by simp) hi
      · have hr : r ∉ rootsN (2 * N) := fun hr =>
          hi (Finset.some_mem_insertNone.2 (Finset.some_mem_insertNone.2 hr))
        simp only [β, hr, ↓reduceIte]
    · rw [Finset.sum_insertNone, Finset.sum_insertNone]
      have e : ∑ r ∈ rootsN (2 * N), β (some (some r)) *
          lamOfBY b ((Real.log (y : ℝ) : ℝ) : ℂ) (some (some r)) =
          ∑ r ∈ rootsN (2 * N), fourierDB b (2 * N) ρ r * Complex.log (1 - r / tB b) :=
        Finset.sum_congr rfl fun r hr => by rw [hβS r hr]; rfl
      rw [e, h1]
      change -(q' : ℂ) * ((Real.log (y : ℝ) : ℝ) : ℂ) + (I * q * (Real.pi * I) +
        (((q : ℝ) * Real.pi + (q' : ℝ) * Real.log (y : ℝ) : ℝ) : ℂ)) = 0
      push_cast
      linear_combination ((q : ℂ) * Real.pi) * Complex.I_sq
  -- if no integer relation involved `log y`, the coefficient `-q'` would be zero
  by_contra hcon
  have hall : ∀ v ∈ IntRel (Finset.insertNone (Finset.insertNone (rootsN (2 * N))))
      (lamOfBY b ((Real.log (y : ℝ) : ℝ) : ℂ)), v none = 0 := by
    rintro v ⟨z, -, hzsum, hvz⟩
    by_contra hv
    refine hcon ⟨rootsN (2 * N), z, hS, fun h0 => hv ?_, ?_⟩
    · rw [hvz, h0, Int.cast_zero]
    · rw [Finset.sum_insertNone, Finset.sum_insertNone] at hzsum
      exact hzsum
  have h0 := Base3.spanIn_linear (fun v : Option (Option ℂ) → ℂ => v none) rfl
    (fun _ _ _ => rfl) hall hspan
  have h0' : -(q' : ℂ) = 0 := h0
  exact hq' (by exact_mod_cast neg_eq_zero.1 h0')

/-! ## 2. The multiplicative relation -/

/-- An integer relation among `log y`, `iπ` and the `Log(1 - r/t)`, doubled and exponentiated:
`y^(2m) ∏ (1 - r/t)^(2 z_r) = 1`. -/
theorem zpow_relation_of_intRel {b : ℕ} (hb : 2 ≤ b) {y : ℚ} (hy : 0 < y) {S : Finset ℂ}
    (hS : ∀ r ∈ S, IsOfFinOrder r) {z : Option (Option ℂ) → ℤ}
    (hz : (z none : ℂ) * ((Real.log (y : ℝ) : ℝ) : ℂ) + ((z (some none) : ℂ) * (Real.pi * I) +
      ∑ r ∈ S, (z (some (some r)) : ℂ) * Complex.log (1 - r / tB b)) = 0) :
    (y : ℂ) ^ (2 * z none) * ∏ r ∈ S, (1 - r / tB b) ^ (2 * z (some (some r))) = 1 := by
  have hΛ : Complex.exp ((Real.log (y : ℝ) : ℝ) : ℂ) = (y : ℂ) := by
    rw [← Complex.ofReal_exp, Real.exp_log (by exact_mod_cast hy)]
    push_cast
    rfl
  have e : ∑ r ∈ S, ((2 * z (some (some r)) : ℤ) : ℂ) * Complex.log (1 - r / tB b) =
      2 * ∑ r ∈ S, (z (some (some r)) : ℂ) * Complex.log (1 - r / tB b) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    push_cast
    ring
  have h2 : ((2 * z none : ℤ) : ℂ) * ((Real.log (y : ℝ) : ℝ) : ℂ) +
      ∑ r ∈ S, ((2 * z (some (some r)) : ℤ) : ℂ) * Complex.log (1 - r / tB b) =
      ((-z (some none) : ℤ) : ℂ) * (2 * Real.pi * I) := by
    rw [e]
    push_cast
    linear_combination 2 * hz
  have h3 := congrArg Complex.exp h2
  rw [Complex.exp_add, Complex.exp_int_mul, hΛ, Complex.exp_sum,
    Complex.exp_int_mul_two_pi_mul_I] at h3
  refine Eq.trans ?_ h3
  congr 1
  refine Finset.prod_congr rfl fun r hr => ?_
  rw [Complex.exp_int_mul, Complex.exp_log (wB_ne_zero hb (hS r hr))]

/-! ## 3. The norm of the relation -/

/-- **The norm of a multiplicative relation.** Let `L` be a finite extension of `ℚ` with an
embedding `φ` in `ℂ` whose image contains `√b` and the roots of unity of `S`. The norm to `ℚ`
of a relation `y^n ∏ (1 - r/t)^(2 e_r) = 1` is `y^(n [L : ℚ]) ∏ ν(r)²^(m_r e_r) = 1`, for some
natural numbers `m_r`. -/
theorem norm_zpow_relation {L : Type*} [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L]
    (φ : L →+* ℂ) {b : ℕ} (hb : 2 ≤ b) {t : L} (ht : φ t = tB b) {S : Finset ℂ}
    (hS : ∀ r ∈ S, IsOfFinOrder r) (g : ℂ → L) (hg : ∀ r ∈ S, φ (g r) = r) {y : ℚ} {n : ℤ}
    {e : ℂ → ℤ} (h : (y : ℂ) ^ n * ∏ r ∈ S, (1 - r / tB b) ^ (2 * e r) = 1) :
    ∃ m : ℂ → ℕ, y ^ (n * (finrank ℚ L : ℤ)) * ∏ r ∈ S, nuSq b r ^ ((m r : ℤ) * e r) = 1 := by
  classical
  -- the relation in `L`
  have hL : (algebraMap ℚ L y) ^ n * ∏ r ∈ S, (1 - g r / t) ^ (2 * e r) = 1 := by
    apply φ.injective
    rw [map_mul, map_zpow₀, map_prod, map_one, eq_ratCast (algebraMap ℚ L) y, map_ratCast,
      ← h]
    congr 1
    refine Finset.prod_congr rfl fun r hr => ?_
    rw [map_zpow₀, map_sub, map_one, map_div₀, hg r hr, ht]
  -- the norms of the factors
  have hm : ∀ r : ℂ, ∃ m : ℕ, r ∈ S → Algebra.norm ℚ (1 - g r / t) ^ 2 = nuSq b r ^ m := by
    intro r
    by_cases hr : r ∈ S
    · obtain ⟨m, hm⟩ := norm_one_sub_div_sq_eq_nuSq φ hb ht (hg r hr)
        (isIntegral_tB_sub b (hS r hr))
      exact ⟨m, fun _ => hm⟩
    · exact ⟨0, fun h => absurd h hr⟩
  choose m hm using hm
  refine ⟨m, ?_⟩
  have hN := congrArg (Algebra.norm ℚ) hL
  rw [map_mul, Algebra.norm_zpow, Algebra.norm_algebraMap, map_prod, map_one] at hN
  rw [← hN, mul_comm n, zpow_mul, zpow_natCast]
  congr 1
  refine Finset.prod_congr rfl fun r hr => ?_
  rw [Algebra.norm_zpow, zpow_mul, zpow_mul, zpow_natCast, ← hm r hr]
  rfl

/-! ## 4. From a relation between rational numbers to `InBaseSpan` -/

/-- A relation `y^N ∏ ν(r)²^(e_r) = 1` with `N ≠ 0` puts `y` in the span of the base numbers. -/
private theorem inBaseSpan_of_zpow {b : ℕ} {y : ℚ} {N : ℤ} (hN : N ≠ 0) {S : Finset ℂ}
    (hS : ∀ r ∈ S, IsOfFinOrder r) {e : ℂ → ℤ}
    (h : y ^ N * ∏ r ∈ S, nuSq b r ^ e r = 1) : InBaseSpan b y := by
  rcases lt_or_gt_of_ne hN with hneg | hpos
  · refine ⟨(-N).toNat, by omega, S, e, hS, ?_⟩
    rw [← zpow_natCast, Int.toNat_of_nonneg (by omega), zpow_neg]
    exact inv_eq_of_mul_eq_one_right h
  · refine ⟨N.toNat, by omega, S, fun r => -e r, hS, ?_⟩
    rw [← zpow_natCast, Int.toNat_of_nonneg hpos.le, eq_inv_of_mul_eq_one_left h,
      ← Finset.prod_inv_distrib]
    exact Finset.prod_congr rfl fun r _ => (zpow_neg _ _).symm

/-! ## 5. The theorem -/

/-- **The values that are logarithms lie in the span of the base numbers** (from Baker's
theorem). If `q π + q' log y`, with `q, q'` rational, `q' ≠ 0` and `y` a positive rational, is
a value of the class `F_b`, then some power of `y` is a product of integer powers of the
numbers `ν(r)²`. -/
theorem inBaseSpan_of_isFBValue (hB : BakerTheorem) {b : ℕ} (hb : 2 ≤ b) {q q' : ℚ}
    (hq' : q' ≠ 0) {y : ℚ} (hy : 0 < y)
    (h : IsFBValue b (q * Real.pi + q' * Real.log y)) : InBaseSpan b y := by
  classical
  obtain ⟨S, z, hS, hz, hrel⟩ := exists_intRel_of_isFBValue hB hb hq' hy h
  have hpow := zpow_relation_of_intRel hb hy hS hrel
  -- the field generated by `√b` and the roots of unity of `S`
  obtain ⟨L, hL⟩ : ∃ L : IntermediateField ℚ ℂ,
      L = IntermediateField.adjoin ℚ (insert (tB b) (S : Set ℂ)) := ⟨_, rfl⟩
  have hmem : ∀ x ∈ insert (tB b) (S : Set ℂ), x ∈ L := fun x hx => by
    rw [hL]
    exact IntermediateField.subset_adjoin ℚ _ hx
  have hfin : FiniteDimensional ℚ L := by
    rw [hL]
    have : Finite (insert (tB b) (S : Set ℂ) : Set ℂ) := (S.finite_toSet.insert _).to_subtype
    refine IntermediateField.finiteDimensional_adjoin fun x hx => ?_
    rcases hx with rfl | hx
    · exact (isAlgebraic_tB b).isIntegral
    · exact ((isIntegral_of_finOrder (hS x hx)).tower_top (A := ℚ))
  have htL : tB b ∈ L := hmem _ (Set.mem_insert _ _)
  have hSL : ∀ r ∈ S, r ∈ L := fun r hr => hmem r (Set.mem_insert_of_mem _ hr)
  obtain ⟨m, hm⟩ := norm_zpow_relation (algebraMap L ℂ) hb (t := ⟨tB b, htL⟩) rfl hS
    (fun r => if hr : r ∈ L then ⟨r, hr⟩ else 0)
    (fun r hr => by simp only [hSL r hr, ↓reduceDIte]; rfl) hpow
  have hD : (finrank ℚ L : ℤ) ≠ 0 := by
    have := Module.finrank_pos (R := ℚ) (M := L)
    omega
  exact inBaseSpan_of_zpow (mul_ne_zero (mul_ne_zero two_ne_zero hz) hD) hS hm

end BaseB

