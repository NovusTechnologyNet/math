module

public import Pilean.Erdos.AbstractIdeal
public import Pilean.Erdos.AbstractGroupRing

/-!
# The algebraic core of Theorem A, part 3: the group ring `R[S]` is a `DSetting`

`R` is a commutative ring of characteristic 0 without zero divisors (used for `ℤ` and `ℚ`),
`S = ∏_p ℤ/2^(s p)`. The elements `d p = 1 - t_p` (`del`), `N p` (`nrm`) and `a p = π p - [u p]`
(`aR`) of `R[S]` satisfy the hypotheses of `DSetting` (`gSetting`).

The exactness facts (the paper's (F2)) modulo the ideal `Q(E, F)`, for an index `r ∉ E ∪ F`, are
proved with slices: `slice R s r x` is the part of `x` supported on the `g` with `g r = 0`, and
`sliceAt R s r c x` is the part of `x` supported on the `g` with `g r = c`, translated to
`g r = 0`. So `x = ∑_c t_r^c * sliceAt R s r c x` (`slice_decomp`), and `Q(E, F)`, which is
generated by elements not involving `t_r`, is stable under slices (`slice_mem`).
-/

@[expose] public section

set_option linter.unusedSectionVars false
set_option linter.unusedFintypeInType false
set_option linter.unusedDecidableInType false

open scoped BigOperators

open AddMonoidAlgebra (single)

namespace PiFormula

namespace Erdos

namespace Abs

variable {ι : Type} [Fintype ι] [DecidableEq ι]

variable (R : Type*) [CommRing R] (s : ι → ℕ)

/-! ### Slices -/

/-- The part of `x` supported on the elements `g` of `S` with `g r = 0`. -/
noncomputable def slice (r : ι) (x : GR R s) : GR R s :=
  ∑ g : Grp s, single g (if g r = 0 then x.coeff g else 0)

theorem coeff_slice (r : ι) (x : GR R s) (g : Grp s) :
    (slice R s r x).coeff g = if g r = 0 then x.coeff g else 0 :=
  coeff_sum_single (fun g => if g r = 0 then x.coeff g else 0) g

theorem slice_zero (r : ι) : slice R s r 0 = 0 :=
  ext_coeff fun g => by simp [coeff_slice]

theorem slice_add (r : ι) (x y : GR R s) :
    slice R s r (x + y) = slice R s r x + slice R s r y :=
  ext_coeff fun g => by
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, coeff_slice, coeff_slice, coeff_slice,
      AddMonoidAlgebra.coeff_add, Finsupp.add_apply]
    split_ifs <;> simp

theorem slice_sub (r : ι) (x y : GR R s) :
    slice R s r (x - y) = slice R s r x - slice R s r y :=
  ext_coeff fun g => by
    rw [AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply, coeff_slice, coeff_slice, coeff_slice,
      AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply]
    split_ifs <;> simp

/-- `slice` as an additive homomorphism. -/
noncomputable def sliceHom (r : ι) : GR R s →+ GR R s where
  toFun := slice R s r
  map_zero' := slice_zero R s r
  map_add' := slice_add R s r

theorem slice_sum {κ : Type*} (r : ι) (t : Finset κ) (f : κ → GR R s) :
    slice R s r (∑ i ∈ t, f i) = ∑ i ∈ t, slice R s r (f i) :=
  map_sum (sliceHom R s r) f t

theorem slice_mul_single (r : ι) (x : GR R s) (h : Grp s) (hh : h r = 0) :
    slice R s r (x * single h 1) = slice R s r x * single h 1 :=
  ext_coeff fun g => by
    rw [coeff_slice, AddMonoidAlgebra.coeff_mul_single_apply,
      AddMonoidAlgebra.coeff_mul_single_apply, coeff_slice]
    have h1 : (g + -h) r = g r := by simp [hh]
    rw [h1]
    split_ifs <;> simp

theorem slice_mul_del (r p : ι) (hp : p ≠ r) (x : GR R s) :
    slice R s r (x * del R s p) = slice R s r x * del R s p := by
  unfold del
  rw [mul_sub, mul_sub, mul_one, mul_one, slice_sub,
    slice_mul_single R s r x _ (Pi.single_eq_of_ne hp.symm _)]

theorem slice_mul_nrm (r p : ι) (hp : p ≠ r) (x : GR R s) :
    slice R s r (x * nrm R s p) = slice R s r x * nrm R s p := by
  unfold nrm
  rw [Finset.mul_sum, Finset.mul_sum, slice_sum]
  exact Finset.sum_congr rfl fun c _ =>
    slice_mul_single R s r x _ (Pi.single_eq_of_ne hp.symm _)

/-- The part of `x` supported on the elements `g` with `g r = c`, translated to `g r = 0`. -/
noncomputable def sliceAt (r : ι) (c : ZMod (2 ^ s r)) (x : GR R s) : GR R s :=
  slice R s r (single (Pi.single r (-c) : Grp s) (1 : R) * x)

theorem sliceAt_zero (r : ι) (x : GR R s) : sliceAt R s r 0 x = slice R s r x := by
  unfold sliceAt
  rw [neg_zero, Pi.single_zero, ← AddMonoidAlgebra.one_def, one_mul]

theorem slice_decomp (r : ι) (x : GR R s) :
    x = ∑ c : ZMod (2 ^ s r), single (Pi.single r c : Grp s) (1 : R) * sliceAt R s r c x :=
  ext_coeff fun g => by
    rw [AddMonoidAlgebra.coeff_sum, Finset.sum_apply']
    simp only [AddMonoidAlgebra.coeff_single_mul_apply, one_mul, sliceAt, coeff_slice]
    rw [Finset.sum_eq_single (g r)]
    · have h1 : (-(Pi.single r (g r) : Grp s) + g) r = 0 := by simp
      have h2 : -(Pi.single r (-(g r)) : Grp s) + (-(Pi.single r (g r) : Grp s) + g) = g := by
        rw [Pi.single_neg]
        abel
      simp only [h1, ↓reduceIte, h2]
    · intro c _ hc
      have h1 : (-(Pi.single r c : Grp s) + g) r ≠ 0 := by
        intro h
        apply hc
        simp only [Pi.add_apply, Pi.neg_apply, Pi.single_eq_same] at h
        linear_combination -h
      simp only [h1, ↓reduceIte]
    · intro h
      exact absurd (Finset.mem_univ _) h

/-! ### The ideals `Q(E, F)` are stable under slices -/

theorem slice_mul_mem (r : ι) (E F : Finset ι) (hE : r ∉ E) (hF : r ∉ F) {x : GR R s}
    (hx : x ∈ qIdeal (del R s) (nrm R s) E F) :
    ∀ z : GR R s, slice R s r (z * x) ∈ qIdeal (del R s) (nrm R s) E F := by
  rw [qIdeal, ← Ideal.span_union] at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    intro z
    rcases hx with ⟨p, hp, rfl⟩ | ⟨p, hp, rfl⟩
    · have hpr : p ≠ r := fun h => hE (h ▸ Finset.mem_coe.1 hp)
      rw [slice_mul_del R s r p hpr]
      exact Ideal.mul_mem_left _ _ (mem_qIdeal_left _ _ F (Finset.mem_coe.1 hp))
    · have hpr : p ≠ r := fun h => hF (h ▸ Finset.mem_coe.1 hp)
      rw [slice_mul_nrm R s r p hpr]
      exact Ideal.mul_mem_left _ _ (mem_qIdeal_right _ _ E (Finset.mem_coe.1 hp))
  | zero =>
    intro z
    rw [mul_zero, slice_zero]
    exact Ideal.zero_mem _
  | add x y _ _ hx hy =>
    intro z
    rw [mul_add, slice_add]
    exact Ideal.add_mem _ (hx z) (hy z)
  | smul c x _ hx =>
    intro z
    rw [smul_eq_mul, ← mul_assoc]
    exact hx (z * c)

theorem slice_mem (r : ι) (E F : Finset ι) (hE : r ∉ E) (hF : r ∉ F) {x : GR R s}
    (hx : x ∈ qIdeal (del R s) (nrm R s) E F) :
    slice R s r x ∈ qIdeal (del R s) (nrm R s) E F := by
  have h := slice_mul_mem R s r E F hE hF hx 1
  rwa [one_mul] at h

theorem sliceAt_mem (r : ι) (E F : Finset ι) (hE : r ∉ E) (hF : r ∉ F) (c : ZMod (2 ^ s r))
    {x : GR R s} (hx : x ∈ qIdeal (del R s) (nrm R s) E F) :
    sliceAt R s r c x ∈ qIdeal (del R s) (nrm R s) E F :=
  slice_mul_mem R s r E F hE hF hx _

/-! ### The exactness facts (F2) modulo `Q(E, F)` -/

theorem h2a_groupRing (E F : Finset ι) (r : ι) (hE : r ∉ E) (hF : r ∉ F) (x : GR R s)
    (hx : del R s r * x ∈ qIdeal (del R s) (nrm R s) E F) :
    ∃ y, x - nrm R s r * y ∈ qIdeal (del R s) (nrm R s) E F := by
  refine ⟨slice R s r x, ?_⟩
  have step : ∀ c : ZMod (2 ^ s r),
      sliceAt R s r c x - sliceAt R s r (c - 1) x ∈ qIdeal (del R s) (nrm R s) E F := by
    intro c
    have h1 : sliceAt R s r c x - sliceAt R s r (c - 1) x = sliceAt R s r c (del R s r * x) := by
      unfold sliceAt
      rw [← slice_sub]
      congr 1
      have h2 : (Pi.single r (-(c - 1)) : Grp s) = Pi.single r (-c) + Pi.single r 1 := by
        rw [← Pi.single_add]
        congr 1
        ring
      rw [del, sub_mul, one_mul, mul_sub, ← mul_assoc, AddMonoidAlgebra.single_mul_single,
        mul_one, h2]
    rw [h1]
    exact sliceAt_mem R s r E F hE hF c hx
  have all : ∀ j : ℕ, sliceAt R s r (j : ZMod (2 ^ s r)) x - sliceAt R s r 0 x ∈
      qIdeal (del R s) (nrm R s) E F := by
    intro j
    induction j with
    | zero =>
      rw [Nat.cast_zero, sub_self]
      exact Ideal.zero_mem _
    | succ j ih =>
      have h1 := step ((j + 1 : ℕ) : ZMod (2 ^ s r))
      rw [Nat.cast_succ, add_sub_cancel_right] at h1
      have h2 : sliceAt R s r ((j : ZMod (2 ^ s r)) + 1) x - sliceAt R s r 0 x =
          (sliceAt R s r ((j : ZMod (2 ^ s r)) + 1) x - sliceAt R s r (j : ZMod (2 ^ s r)) x) +
            (sliceAt R s r (j : ZMod (2 ^ s r)) x - sliceAt R s r 0 x) := by ring
      rw [Nat.cast_succ, h2]
      exact Ideal.add_mem _ h1 ih
  have all' : ∀ c : ZMod (2 ^ s r),
      sliceAt R s r c x - sliceAt R s r 0 x ∈ qIdeal (del R s) (nrm R s) E F := by
    intro c
    have h1 := all c.val
    rwa [ZMod.natCast_zmod_val] at h1
  have h3 : x - nrm R s r * slice R s r x = ∑ c : ZMod (2 ^ s r),
      single (Pi.single r c : Grp s) (1 : R) * (sliceAt R s r c x - sliceAt R s r 0 x) := by
    simp only [mul_sub, Finset.sum_sub_distrib]
    rw [← slice_decomp R s r x, ← Finset.sum_mul, sliceAt_zero]
    rfl
  rw [h3]
  exact sum_mem fun c _ => Ideal.mul_mem_left _ _ (all' c)

theorem h2b_groupRing (E F : Finset ι) (r : ι) (hE : r ∉ E) (hF : r ∉ F) (x : GR R s)
    (hx : nrm R s r * x ∈ qIdeal (del R s) (nrm R s) E F) :
    ∃ y, x - del R s r * y ∈ qIdeal (del R s) (nrm R s) E F := by
  choose h hh using exists_single_sub_one R s r
  refine ⟨∑ c : ZMod (2 ^ s r), h c * sliceAt R s r c x, ?_⟩
  have h1 : slice R s r (nrm R s r * x) = ∑ c : ZMod (2 ^ s r), sliceAt R s r c x := by
    rw [nrm, Finset.sum_mul, slice_sum]
    refine Fintype.sum_equiv (Equiv.neg _) _ _ fun c => ?_
    simp [sliceAt]
  have h2 : x - del R s r * ∑ c : ZMod (2 ^ s r), h c * sliceAt R s r c x =
      ∑ c : ZMod (2 ^ s r), sliceAt R s r c x := by
    have h3 : x - del R s r * ∑ c : ZMod (2 ^ s r), h c * sliceAt R s r c x =
        (∑ c : ZMod (2 ^ s r), single (Pi.single r c : Grp s) (1 : R) * sliceAt R s r c x) -
          del R s r * ∑ c : ZMod (2 ^ s r), h c * sliceAt R s r c x := by
      rw [← slice_decomp R s r x]
    rw [h3, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    linear_combination (sliceAt R s r c x) * hh c
  rw [h2, ← h1]
  exact slice_mem R s r E F hE hF hx

/-! ### The setting -/

/-- The `DSetting` of the group ring `R[S]`. -/
noncomputable def gSetting [CharZero R] [NoZeroDivisors R] (π : ι → ℤ) (u : ι → Grp s)
    (hπ : ∀ p, 1 < π p) : DSetting (GR R s) ι where
  d := del R s
  N := nrm R s
  a := aR R s π u
  d_mul_N := del_mul_nrm R s
  h2a := h2a_groupRing R s
  h2b := h2b_groupRing R s
  tors := fun _ hk _ h => intCast_mul_eq_zero R s hk h
  ha := fun p => by
    obtain ⟨b, hb⟩ := aR_dvd R s π u p
    refine ⟨b, _, ?_, hb⟩
    have h1 : 1 < π p ^ Fintype.card (Grp s) := one_lt_pow₀ (hπ p) Fintype.card_ne_zero
    omega

end Abs

end Erdos

end PiFormula
