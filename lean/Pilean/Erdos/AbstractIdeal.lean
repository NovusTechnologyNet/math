    have hw1mem := ih E (insert r F) hmE hmF2 hEF2 hw1K
    rw [S.Q_insert_right, ← sup_assoc] at hw1mem
    obtain ⟨w₂, hw₂⟩ := mem_sup_span_singleton.1 hw1mem
    obtain ⟨κ', hκ', q', hq', hκq'⟩ := Submodule.mem_sup.1 hw₂
    have h : z = (S.a r * κ + S.d r * κ') +
        ((z - S.a r * κ - S.d r * (w + S.a r * w')) + S.d r * q') +
          (S.d r * (w + S.a r * w' - S.N r * w₂ - (κ' + q')) + w₂ * (S.d r * S.N r)) := by
      ring
    rw [h, hκq', sub_self, mul_zero, S.d_mul_N, mul_zero, add_zero, add_zero]
    exact Ideal.add_mem _
      (Ideal.mem_sup_left (Ideal.add_mem _ (S.a_mul_mem_K hr hκ) (S.d_mul_mem_K hr hκ')))
      (Ideal.mem_sup_right (Ideal.add_mem _ hz1 (Ideal.mul_mem_left _ _ hq')))

