import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.Ideal.Lattice
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic.Ring

/-!
# The algebraic core of Theorem A, part 1: Lemma D in dual form, in an abstract ring

This file is pure commutative algebra; no group ring occurs. The setting (`DSetting`):

* a commutative ring `A`, a set `ι` of indices, elements `d r`, `N r`, `a r` of `A` (in the
  application `A = ℤ[S]`, `d r = 1 - t_r`, `N r = 1 + t_r + ... `, `a r = π_r - [u_r]`);
* `d r * N r = 0`;
* for finite sets `E`, `F` of indices, `Q E F` is the ideal generated by the `d r` (`r ∈ E`) and
  the `N r` (`r ∈ F`); the two "exactness" facts (the paper's (F2)), for `r ∉ E ∪ F`:
  `d r * x ∈ Q E F` implies `x ∈ N r * A + Q E F`, and `N r * x ∈ Q E F` implies
  `x ∈ d r * A + Q E F`;
* `A` has no `ℤ`-torsion and every `a p` divides a non-zero integer (this gives the paper's
  (F1): `a p` is not a zero divisor modulo `Q E F`, `DSetting.h1`).

The result (`DSetting.lemmaD`) is the dual form of Lemma D of `02_proof_part_II.md`: with
`K m = ∏_{p ∈ m} (d p, a p)` (an ideal, generated by the `(∏_{p ∈ n} d p)(∏_{p ∈ m ∖ n} a p)`),

  if `z * ∏_{p ∈ n} N p ∈ (∏_{p ∈ n} a p) A + Q E F` for all `n ⊆ m`, then `z ∈ K m + Q E F`.

The proof is the induction of the paper with the roles of `N r` and `1 - t_r` exchanged. Instead
of passing to the rings `L/(1 - t_r)` and `L/(N_r)` (the paper's settings (S1) and (S2)) the
ring stays fixed and the ideal `Q E F` grows: (S1) is `(insert r E, F)`, (S2) is
`(E, insert r F)`. The dual form makes the lattice duality (L1), (L2) of the paper unnecessary.
-/

open scoped BigOperators

namespace PiFormula

namespace Erdos

namespace Abs

variable {A : Type*} [CommRing A] {ι : Type*} [DecidableEq ι]

theorem mem_sup_span_singleton {I : Ideal A} {y x : A} :
    x ∈ I ⊔ Ideal.span {y} ↔ ∃ w, x - y * w ∈ I := by
  constructor
  · intro h
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 h
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 hb
    exact ⟨c, by rwa [show a + c * y - y * c = a by ring]⟩
  · rintro ⟨w, hw⟩
    have h : x = (x - y * w) + w * y := by ring
    rw [h]
    exact Ideal.add_mem _ (Ideal.mem_sup_left hw)
      (Ideal.mem_sup_right (Ideal.mem_span_singleton'.2 ⟨w, rfl⟩))

/-- The ideal generated by the `d r` (`r ∈ E`) and the `N r` (`r ∈ F`). -/
def qIdeal (d N : ι → A) (E F : Finset ι) : Ideal A :=
  Ideal.span (d '' (E : Set ι)) ⊔ Ideal.span (N '' (F : Set ι))

omit [DecidableEq ι] in
theorem qIdeal_empty (d N : ι → A) : qIdeal d N ∅ ∅ = ⊥ := by simp [qIdeal]

theorem qIdeal_insert_left (d N : ι → A) (E F : Finset ι) (r : ι) :
    qIdeal d N (insert r E) F = qIdeal d N E F ⊔ Ideal.span {d r} := by
  simp only [qIdeal, Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert]
  rw [sup_comm (Ideal.span {d r}), sup_right_comm]

theorem qIdeal_insert_right (d N : ι → A) (E F : Finset ι) (r : ι) :
    qIdeal d N E (insert r F) = qIdeal d N E F ⊔ Ideal.span {N r} := by
  simp only [qIdeal, Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert]
  rw [sup_comm (Ideal.span {N r}), sup_assoc]

omit [DecidableEq ι] in
theorem mem_qIdeal_left (d N : ι → A) {E : Finset ι} (F : Finset ι) {r : ι} (hr : r ∈ E) :
    d r ∈ qIdeal d N E F :=
  Ideal.mem_sup_left (Ideal.subset_span ⟨r, hr, rfl⟩)

omit [DecidableEq ι] in
theorem mem_qIdeal_right (d N : ι → A) (E : Finset ι) {F : Finset ι} {r : ι} (hr : r ∈ F) :
    N r ∈ qIdeal d N E F :=
  Ideal.mem_sup_right (Ideal.subset_span ⟨r, hr, rfl⟩)

/-- The data and the hypotheses of the abstract Lemma D. -/
structure DSetting (A : Type*) [CommRing A] (ι : Type*) [DecidableEq ι] where
  /-- In the application: `1 - t_r`. -/
  d : ι → A
  /-- In the application: the sum of the elements of the cyclic group `C_r`. -/
  N : ι → A
  /-- In the application: `π_r - [u_r]`. -/
  a : ι → A
  d_mul_N : ∀ r, d r * N r = 0
  h2a : ∀ (E F : Finset ι) (r : ι), r ∉ E → r ∉ F → ∀ x, d r * x ∈ qIdeal d N E F →
    ∃ y, x - N r * y ∈ qIdeal d N E F
  h2b : ∀ (E F : Finset ι) (r : ι), r ∉ E → r ∉ F → ∀ x, N r * x ∈ qIdeal d N E F →
    ∃ y, x - d r * y ∈ qIdeal d N E F
  tors : ∀ k : ℤ, k ≠ 0 → ∀ x : A, (k : A) * x = 0 → x = 0
  ha : ∀ p, ∃ (b : A) (k : ℤ), k ≠ 0 ∧ a p * b = (k : A)

namespace DSetting

variable (S : DSetting A ι)

/-- The ideal `Q(E, F)`. -/
def Q (E F : Finset ι) : Ideal A := qIdeal S.d S.N E F

theorem Q_insert_left (E F : Finset ι) (r : ι) :
    S.Q (insert r E) F = S.Q E F ⊔ Ideal.span {S.d r} := qIdeal_insert_left _ _ _ _ _

theorem Q_insert_right (E F : Finset ι) (r : ι) :
    S.Q E (insert r F) = S.Q E F ⊔ Ideal.span {S.N r} := qIdeal_insert_right _ _ _ _ _

/-- `∏_{p ∈ n} d p`. -/
def dP (n : Finset ι) : A := ∏ p ∈ n, S.d p

/-- `∏_{p ∈ n} N p`. -/
def NP (n : Finset ι) : A := ∏ p ∈ n, S.N p

/-- `∏_{p ∈ n} a p`. -/
def aP (n : Finset ι) : A := ∏ p ∈ n, S.a p

theorem dP_insert {n : Finset ι} {r : ι} (h : r ∉ n) : S.dP (insert r n) = S.d r * S.dP n :=
  Finset.prod_insert h

theorem NP_insert {n : Finset ι} {r : ι} (h : r ∉ n) : S.NP (insert r n) = S.N r * S.NP n :=
  Finset.prod_insert h

theorem aP_insert {n : Finset ι} {r : ι} (h : r ∉ n) : S.aP (insert r n) = S.a r * S.aP n :=
  Finset.prod_insert h

/-! ### No torsion modulo `Q E F`, and (F1) -/

theorem tors_Q_right (F : Finset ι) :
    ∀ k : ℤ, k ≠ 0 → ∀ x : A, (k : A) * x ∈ S.Q ∅ F → x ∈ S.Q ∅ F := by
  induction F using Finset.induction_on with
  | empty =>
    intro k hk x hx
    have h : S.Q ∅ ∅ = ⊥ := qIdeal_empty _ _
    rw [h] at hx ⊢
    exact Ideal.mem_bot.2 (S.tors k hk x (Ideal.mem_bot.1 hx))
  | insert r F hr ih =>
    intro k hk x hx
    rw [S.Q_insert_right] at hx ⊢
    obtain ⟨w, hw⟩ := mem_sup_span_singleton.1 hx
    have h1 : (k : A) * (S.d r * x) ∈ S.Q ∅ F := by
      have h : (k : A) * (S.d r * x) =
          S.d r * ((k : A) * x - S.N r * w) + w * (S.d r * S.N r) := by ring
      rw [h, S.d_mul_N, mul_zero, add_zero]
      exact Ideal.mul_mem_left _ _ hw
    obtain ⟨y, hy⟩ := S.h2a ∅ F r (Finset.notMem_empty r) hr x (ih k hk _ h1)
    exact mem_sup_span_singleton.2 ⟨y, hy⟩

theorem tors_Q (E : Finset ι) : ∀ F : Finset ι, Disjoint E F →
    ∀ k : ℤ, k ≠ 0 → ∀ x : A, (k : A) * x ∈ S.Q E F → x ∈ S.Q E F := by
  induction E using Finset.induction_on with
  | empty => intro F _; exact S.tors_Q_right F
  | insert r E hr ih =>
    intro F hF k hk x hx
    rw [Finset.disjoint_insert_left] at hF
    rw [S.Q_insert_left] at hx ⊢
    obtain ⟨w, hw⟩ := mem_sup_span_singleton.1 hx
    have h1 : (k : A) * (S.N r * x) ∈ S.Q E F := by
      have h : (k : A) * (S.N r * x) =
          S.N r * ((k : A) * x - S.d r * w) + w * (S.d r * S.N r) := by ring
      rw [h, S.d_mul_N, mul_zero, add_zero]
      exact Ideal.mul_mem_left _ _ hw
    obtain ⟨y, hy⟩ := S.h2b E F r hr hF.1 x (ih F hF.2 k hk _ h1)
    exact mem_sup_span_singleton.2 ⟨y, hy⟩

/-- (F1): `a p` is not a zero divisor modulo `Q E F`. -/
theorem h1 {E F : Finset ι} (hEF : Disjoint E F) (p : ι) {x : A} (hx : S.a p * x ∈ S.Q E F) :
    x ∈ S.Q E F := by
  obtain ⟨b, k, hk, hb⟩ := S.ha p
  refine S.tors_Q E F hEF k hk x ?_
  have h : (k : A) * x = b * (S.a p * x) := by rw [← hb]; ring
  rw [h]
  exact Ideal.mul_mem_left _ _ hx

theorem h1' {E F : Finset ι} (hEF : Disjoint E F) (n : Finset ι) :
    ∀ {x : A}, S.aP n * x ∈ S.Q E F → x ∈ S.Q E F := by
  induction n using Finset.induction_on with
  | empty => intro x hx; simpa [aP] using hx
  | insert p n hp ih =>
    intro x hx
    rw [S.aP_insert hp, mul_assoc] at hx
    exact ih (S.h1 hEF p hx)

/-! ### The two ideals -/

/-- `K m`: the ideal generated by the `(∏_{p ∈ n} d p)(∏_{p ∈ m ∖ n} a p)`, `n ⊆ m`; it is the
product of the ideals `(d p, a p)`, `p ∈ m`. -/
def K (m : Finset ι) : Ideal A :=
  Ideal.span {x | ∃ n, n ⊆ m ∧ x = S.dP n * S.aP (m \ n)}

/-- `K^# m` relative to `Q E F`: the `z` with `z * ∏_{p ∈ n} N p ∈ (∏_{p ∈ n} a p) A + Q E F`
for all `n ⊆ m`. -/
def KS (m E F : Finset ι) : Ideal A where
  carrier := {z | ∀ n, n ⊆ m → ∃ v, z * S.NP n - S.aP n * v ∈ S.Q E F}
  add_mem' := by
    intro x y hx hy n hn
    obtain ⟨v, hv⟩ := hx n hn
    obtain ⟨w, hw⟩ := hy n hn
    refine ⟨v + w, ?_⟩
    have h : (x + y) * S.NP n - S.aP n * (v + w) =
        (x * S.NP n - S.aP n * v) + (y * S.NP n - S.aP n * w) := by ring
    rw [h]
    exact Ideal.add_mem _ hv hw
  zero_mem' := fun n _ => ⟨0, by simp⟩
  smul_mem' := by
    intro c x hx n hn
    obtain ⟨v, hv⟩ := hx n hn
    refine ⟨c * v, ?_⟩
    have h : c • x * S.NP n - S.aP n * (c * v) = c * (x * S.NP n - S.aP n * v) := by
      rw [smul_eq_mul]; ring
    rw [h]
    exact Ideal.mul_mem_left _ _ hv

theorem mem_KS {m E F : Finset ι} {z : A} :
    z ∈ S.KS m E F ↔ ∀ n, n ⊆ m → ∃ v, z * S.NP n - S.aP n * v ∈ S.Q E F := Iff.rfl

theorem Q_le_KS (m E F : Finset ι) : S.Q E F ≤ S.KS m E F := by
  intro q hq n _
  exact ⟨0, by rw [mul_zero, sub_zero]; exact Ideal.mul_mem_right _ _ hq⟩

theorem dP_mul_NP_eq_zero {k n : Finset ι} {p : ι} (hk : p ∈ k) (hn : p ∈ n) :
    S.dP k * S.NP n = 0 := by
  rw [dP, NP, ← Finset.mul_prod_erase k _ hk, ← Finset.mul_prod_erase n _ hn]
  have h : (S.d p * ∏ x ∈ k.erase p, S.d x) * (S.N p * ∏ x ∈ n.erase p, S.N x) =
      (S.d p * S.N p) * ((∏ x ∈ k.erase p, S.d x) * ∏ x ∈ n.erase p, S.N x) := by ring
  rw [h, S.d_mul_N, zero_mul]

/-- The easy inclusion. -/
theorem K_le_KS (m E F : Finset ι) : S.K m ≤ S.KS m E F := by
  refine Ideal.span_le.2 ?_
  rintro x ⟨k, -, rfl⟩ n hn
  by_cases hdis : Disjoint n k
  · have hsub : n ⊆ m \ k := fun p hp =>
      Finset.mem_sdiff.2 ⟨hn hp, Finset.disjoint_left.1 hdis hp⟩
    refine ⟨S.dP k * S.aP ((m \ k) \ n) * S.NP n, ?_⟩
    have h1 : S.aP ((m \ k) \ n) * S.aP n = S.aP (m \ k) := Finset.prod_sdiff hsub
    have h : S.dP k * S.aP (m \ k) * S.NP n -
        S.aP n * (S.dP k * S.aP ((m \ k) \ n) * S.NP n) = 0 := by
      rw [← h1]; ring
    rw [h]
    exact Ideal.zero_mem _
  · obtain ⟨p, hpn, hpk⟩ := Finset.not_disjoint_iff.1 hdis
    refine ⟨0, ?_⟩
    rw [mul_zero, sub_zero, mul_right_comm, S.dP_mul_NP_eq_zero hpk hpn, zero_mul]
    exact Ideal.zero_mem _

theorem a_mul_mem_K {m : Finset ι} {r : ι} (hr : r ∉ m) {x : A} (hx : x ∈ S.K m) :
    S.a r * x ∈ S.K (insert r m) := by
  unfold K at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, hn, rfl⟩ := hx
    refine Ideal.subset_span ⟨n, hn.trans (Finset.subset_insert _ _), ?_⟩
    have hrn : r ∉ n := fun h => hr (hn h)
    have hrm : r ∉ m \ n := fun h => hr (Finset.mem_sdiff.1 h).1
    rw [Finset.insert_sdiff_of_notMem _ hrn, S.aP_insert hrm]
    ring
  | zero => rw [mul_zero]; exact Ideal.zero_mem _
  | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
  | smul c x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx

theorem d_mul_mem_K {m : Finset ι} {r : ι} (hr : r ∉ m) {x : A} (hx : x ∈ S.K m) :
    S.d r * x ∈ S.K (insert r m) := by
  unfold K at hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, hn, rfl⟩ := hx
    refine Ideal.subset_span ⟨insert r n, Finset.insert_subset_insert r hn, ?_⟩
    have hrn : r ∉ n := fun h => hr (hn h)
    rw [Finset.insert_sdiff_insert, Finset.sdiff_insert_of_notMem hr, S.dP_insert hrn]
    ring
  | zero => rw [mul_zero]; exact Ideal.zero_mem _
  | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
  | smul c x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx

theorem K_empty : S.K ∅ = ⊤ := by
  refine (Ideal.eq_top_iff_one _).2 (Ideal.subset_span ⟨∅, subset_rfl, ?_⟩)
  simp [dP, aP]

/-! ### Lemma D, dual form -/

/-- **Lemma D in dual form.** If `z * ∏_{p ∈ n} N p ∈ (∏_{p ∈ n} a p) A + Q E F` for all
`n ⊆ m`, then `z ∈ K m + Q E F`. -/
theorem lemmaD (m : Finset ι) : ∀ E F : Finset ι, Disjoint m E → Disjoint m F → Disjoint E F →
    S.KS m E F ≤ S.K m ⊔ S.Q E F := by
  induction m using Finset.induction_on with
  | empty =>
    intro E F _ _ _ z _
    rw [S.K_empty]
    exact Ideal.mem_sup_left Submodule.mem_top
  | insert r m hr ih =>
    intro E F hmE hmF hEF z hz
    rw [Finset.disjoint_insert_left] at hmE hmF
    obtain ⟨hrE, hmE⟩ := hmE
    obtain ⟨hrF, hmF⟩ := hmF
    have hEF1 : Disjoint (insert r E) F := Finset.disjoint_insert_left.2 ⟨hrF, hEF⟩
    have hEF2 : Disjoint E (insert r F) := Finset.disjoint_insert_right.2 ⟨hrE, hEF⟩
    have hmE1 : Disjoint m (insert r E) := Finset.disjoint_insert_right.2 ⟨hr, hmE⟩
    have hmF2 : Disjoint m (insert r F) := Finset.disjoint_insert_right.2 ⟨hr, hmF⟩
    -- Step 1: `z = a r * y' + d r * w` modulo `Q`.
    obtain ⟨y, hy⟩ := hz {r} (Finset.singleton_subset_iff.2 (Finset.mem_insert_self r m))
    have hNr : S.NP {r} = S.N r := Finset.prod_singleton _ _
    have har : S.aP {r} = S.a r := Finset.prod_singleton _ _
    rw [hNr, har] at hy
    have h1 : S.a r * (S.d r * y) ∈ S.Q E F := by
      have h : S.a r * (S.d r * y) =
          -S.d r * (z * S.N r - S.a r * y) + z * (S.d r * S.N r) := by ring
      rw [h, S.d_mul_N, mul_zero, add_zero]
      exact Ideal.mul_mem_left _ _ hy
    obtain ⟨y', hy'⟩ := S.h2a E F r hrE hrF y (S.h1 hEF r h1)
    have h3 : S.N r * (z - S.a r * y') ∈ S.Q E F := by
      have h : S.N r * (z - S.a r * y') =
          (z * S.N r - S.a r * y) + S.a r * (y - S.N r * y') := by ring
      rw [h]
      exact Ideal.add_mem _ hy (Ideal.mul_mem_left _ _ hy')
    obtain ⟨w, hw⟩ := S.h2b E F r hrE hrF _ h3
    -- Step 2: `y'` lies in `K^# m` relative to `Q (insert r E) F`.
    have hy'K : y' ∈ S.KS m (insert r E) F := by
      intro n hn
      have hrn : r ∉ n := fun h => hr (hn h)
      obtain ⟨v, hv⟩ := hz (insert r n) (Finset.insert_subset_insert r hn)
      rw [S.NP_insert hrn, S.aP_insert hrn] at hv
      have h4 : S.a r * (S.N r * y' * S.NP n - S.aP n * v) ∈ S.Q E F := by
        have h : S.a r * (S.N r * y' * S.NP n - S.aP n * v) =
            (z * (S.N r * S.NP n) - S.a r * S.aP n * v) -
              S.NP n * (S.N r * (z - S.a r * y')) := by ring
        rw [h]
        exact Ideal.sub_mem _ hv (Ideal.mul_mem_left _ _ h3)
      have h5 := S.h1 hEF r h4
      have h6 : S.aP n * (S.d r * v) ∈ S.Q E F := by
        have h : S.aP n * (S.d r * v) =
            -S.d r * (S.N r * y' * S.NP n - S.aP n * v) +
              y' * S.NP n * (S.d r * S.N r) := by ring
        rw [h, S.d_mul_N, mul_zero, add_zero]
        exact Ideal.mul_mem_left _ _ h5
      obtain ⟨v', hv'⟩ := S.h2a E F r hrE hrF v (S.h1' hEF n h6)
      have h8 : S.N r * (y' * S.NP n - S.aP n * v') ∈ S.Q E F := by
        have h : S.N r * (y' * S.NP n - S.aP n * v') =
            (S.N r * y' * S.NP n - S.aP n * v) + S.aP n * (v - S.N r * v') := by ring
        rw [h]
        exact Ideal.add_mem _ h5 (Ideal.mul_mem_left _ _ hv')
      obtain ⟨w'', hw''⟩ := S.h2b E F r hrE hrF _ h8
      refine ⟨v', ?_⟩
      rw [S.Q_insert_left]
      exact mem_sup_span_singleton.2 ⟨w'', hw''⟩
    have hy'mem := ih (insert r E) F hmE1 hmF hEF1 hy'K
    rw [S.Q_insert_left, ← sup_assoc] at hy'mem
    obtain ⟨w', hw'⟩ := mem_sup_span_singleton.1 hy'mem
    obtain ⟨κ, hκ, q, hq, hκq⟩ := Submodule.mem_sup.1 hw'
    have hz1 : z - S.a r * κ - S.d r * (w + S.a r * w') ∈ S.Q E F := by
      have h : z - S.a r * κ - S.d r * (w + S.a r * w') =
          (z - S.a r * y' - S.d r * w) + S.a r * q + S.a r * (y' - S.d r * w' - (κ + q)) := by
        ring
      rw [h, hκq, sub_self, mul_zero, add_zero]
      exact Ideal.add_mem _ hw (Ideal.mul_mem_left _ _ hq)
    -- Step 3: `w₁ = w + a r * w'` lies in `K^# m` relative to `Q E (insert r F)`.
    have hdw : S.d r * (w + S.a r * w') ∈ S.KS (insert r m) E F := by
      have h : S.d r * (w + S.a r * w') =
          z - S.a r * κ - (z - S.a r * κ - S.d r * (w + S.a r * w')) := by ring
      rw [h]
      exact Ideal.sub_mem _
        (Ideal.sub_mem _ hz (S.K_le_KS _ E F (S.a_mul_mem_K hr hκ))) (S.Q_le_KS _ E F hz1)
    have hw1K : w + S.a r * w' ∈ S.KS m E (insert r F) := by
      intro n hn
      obtain ⟨v, hv⟩ := hdw n (hn.trans (Finset.subset_insert _ _))
      have h9 : S.aP n * v ∈ S.Q (insert r E) F := by
        rw [S.Q_insert_left]
        refine mem_sup_span_singleton.2 ⟨(w + S.a r * w') * S.NP n, ?_⟩
        have h : S.aP n * v - S.d r * ((w + S.a r * w') * S.NP n) =
            -(S.d r * (w + S.a r * w') * S.NP n - S.aP n * v) := by ring
