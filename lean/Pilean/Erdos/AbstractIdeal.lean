        exact neg_mem hv
      have h10 := S.h1' hEF1 n h9
      rw [S.Q_insert_left] at h10
      obtain ⟨v', hv'⟩ := mem_sup_span_singleton.1 h10
      have h11 : S.d r * ((w + S.a r * w') * S.NP n - S.aP n * v') ∈ S.Q E F := by
        have h : S.d r * ((w + S.a r * w') * S.NP n - S.aP n * v') =
            (S.d r * (w + S.a r * w') * S.NP n - S.aP n * v) + S.aP n * (v - S.d r * v') := by
