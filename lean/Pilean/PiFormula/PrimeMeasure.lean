module

public import Pilean.PiFormula.Classes

/-!
# Theorem E, the prime measure: the least `mean(1/s)` is 7/24

For a pattern `ρ` and a class `c` of primes modulo 120, a prime `p ≡ c` first enters a
denominator of the series at `k = s p`, where `s = firstNZ ρ c` is the least `s ≥ 1` with
`ρ(s c) ≠ 0`. The per-prime state of the window algorithm is proportional to
`primeCost ρ`, the mean of `1/s` over the 32 classes.

* `primeCost_ge` (from Baker's theorem): every series of the class F whose value is a
  non-zero rational multiple of `π` has `primeCost ≥ 7/24`.
* `primeCost_rhoNew`: the new formula of `NewFormula.lean` has `primeCost = 7/24`.

The proof of the bound replaces the enumeration of 6,724,520 cases of exact_optimum.py by
a tree of 13 cases (theorem_e_experiment.py). The 32 classes fall into four types
(`c mod 12`), so `primeCost` is the mean of four numbers `1/s` (`primeCost_namedComb`), and
the tree uses 17 linear facts on the coordinates (section 2, generated by scripts/egen.py):
which conditions force which, and which force the value 0.
-/

@[expose] public section

open Complex

namespace PiFormula

/-! ## 1. The first non-zero term along a chain -/

/-- Search for the least `s ≥ start` with `ρ(s c) ≠ 0`, in at most `fuel` steps. -/
def firstNZAux (ρ : ℕ → ℚ) (c : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 0
  | fuel + 1, s => if ρ (s * c) ≠ 0 then s else firstNZAux ρ c fuel (s + 1)

/-- The least `s` with `1 ≤ s ≤ 120` and `ρ(s c) ≠ 0`, and 0 if there is none. For a pattern
of period 120 this is the least `s ≥ 1` with `ρ(s c) ≠ 0`. -/
def firstNZ (ρ : ℕ → ℚ) (c : ℕ) : ℕ := firstNZAux ρ c 120 1

/-- The mean of `1/s` over the 32 classes of primes modulo 120. -/
def primeCost (ρ : ℕ → ℚ) : ℚ := (unitsList.map fun c => 1 / (firstNZ ρ c : ℚ)).sum / 32

theorem firstNZAux_eq {ρ : ℕ → ℚ} {c : ℕ} : ∀ (fuel s t : ℕ), s ≤ t → t < s + fuel →
    (∀ u, s ≤ u → u < t → ρ (u * c) = 0) → ρ (t * c) ≠ 0 → firstNZAux ρ c fuel s = t := by
  intro fuel
  induction fuel with
  | zero =>
    intro s t h1 h2
    omega
  | succ fuel ih =>
    intro s t h1 h2 hz hnz
    rw [firstNZAux]
    by_cases hst : s = t
    · rw [hst, ite_eq_left_of_eq_true _ _ (eq_true hnz)]
    · have hlt : s < t := lt_of_le_of_ne h1 hst
      have h0 : ¬ ρ (s * c) ≠ 0 := not_not.2 (hz s le_rfl hlt)
      rw [ite_eq_right_of_eq_false _ _ (eq_false h0)]
      exact ih (s + 1) t hlt (by omega) (fun u hu hut => hz u (by omega) hut) hnz

theorem firstNZ_eq {ρ : ℕ → ℚ} {c t : ℕ} (h1 : 1 ≤ t) (h2 : t ≤ 120)
    (hz : ∀ u, 1 ≤ u → u < t → ρ (u * c) = 0) (hnz : ρ (t * c) ≠ 0) : firstNZ ρ c = t :=
  firstNZAux_eq 120 1 t h1 (by omega) hz hnz

/-- If `ρ(t c) ≠ 0` for some `1 ≤ t ≤ 120`, then `1 ≤ firstNZ ρ c ≤ t`. -/
theorem firstNZ_le {ρ : ℕ → ℚ} {c t : ℕ} (h1 : 1 ≤ t) (h2 : t ≤ 120) (hnz : ρ (t * c) ≠ 0) :
    1 ≤ firstNZ ρ c ∧ firstNZ ρ c ≤ t := by
  have hex : ∃ u, 1 ≤ u ∧ ρ (u * c) ≠ 0 := ⟨t, h1, hnz⟩
  classical
  have hspec := Nat.find_spec hex
  have hle : Nat.find hex ≤ t := Nat.find_min' hex ⟨h1, hnz⟩
  have heq : firstNZ ρ c = Nat.find hex := by
    refine firstNZ_eq hspec.1 (by omega) (fun u hu hut => ?_) hspec.2
    by_contra hne
    exact Nat.find_min hex hut ⟨hu, hne⟩
  rw [heq]
  exact ⟨hspec.1, hle⟩

/-- A lower bound for `1/s`: if `ρ(t c) ≠ 0` for some `1 ≤ t ≤ m`, then `1/m ≤ 1/s`. -/
theorem inv_firstNZ_ge {ρ : ℕ → ℚ} {c t : ℕ} (m : ℕ) (h1 : 1 ≤ t) (h2 : t ≤ m)
    (hm : m ≤ 120) (hnz : ρ (t * c) ≠ 0) {b : ℚ} (hb : b = 1 / (m : ℚ)) :
    b ≤ 1 / (firstNZ ρ c : ℚ) := by
  obtain ⟨h3, h4⟩ := firstNZ_le h1 (by omega) hnz
  have hs : (0 : ℚ) < (firstNZ ρ c : ℚ) := by exact_mod_cast h3
  rw [hb]
  exact one_div_le_one_div_of_le hs (by exact_mod_cast (h4.trans h2))

theorem firstNZAux_congr {ρ : ℕ → ℚ} {c c' : ℕ} : ∀ (fuel s : ℕ),
    (∀ u, s ≤ u → u < s + fuel → (ρ (u * c) = 0 ↔ ρ (u * c') = 0)) →
    firstNZAux ρ c fuel s = firstNZAux ρ c' fuel s := by
  intro fuel
  induction fuel with
  | zero =>
    intro s _
    rfl
  | succ fuel ih =>
    intro s h
    rw [firstNZAux, firstNZAux]
    have h0 := h s le_rfl (by omega)
    have ih' := ih (s + 1) fun u hu hut => h u (by omega) (by omega)
    by_cases hs : ρ (s * c) = 0
    · have hs' : ρ (s * c') = 0 := h0.1 hs
      rw [ite_eq_right_of_eq_false _ _ (eq_false (not_not.2 hs)),
        ite_eq_right_of_eq_false _ _ (eq_false (not_not.2 hs')), ih']
    · have hs' : ρ (s * c') ≠ 0 := fun h' => hs (h0.2 h')
      rw [ite_eq_left_of_eq_true _ _ (eq_true hs), ite_eq_left_of_eq_true _ _ (eq_true hs')]

/-- `firstNZ` depends only on which entries along the chain vanish. -/
theorem firstNZ_congr {ρ : ℕ → ℚ} {c c' : ℕ}
    (h : ∀ s, 1 ≤ s → s ≤ 120 → (ρ (s * c) = 0 ↔ ρ (s * c') = 0)) :
    firstNZ ρ c = firstNZ ρ c' :=
  firstNZAux_congr 120 1 fun u hu hut => h u hu (by omega)

/-- **Four types.** For a pattern of `V`, `primeCost` is the mean of four numbers. -/
theorem primeCost_namedComb (q : Fin 8 → ℚ) :
    primeCost (namedComb q) =
      (1 / (firstNZ (namedComb q) 1 : ℚ) + 1 / (firstNZ (namedComb q) 7 : ℚ)
        + 1 / (firstNZ (namedComb q) 11 : ℚ) + 1 / (firstNZ (namedComb q) 17 : ℚ)) / 4 := by
  have h1 : (unitsList.map fun c => 1 / (firstNZ (namedComb q) c : ℚ)) =
      (unitsList.map typeRep).map fun c => 1 / (firstNZ (namedComb q) c : ℚ) := by
    rw [List.map_map]
    refine List.map_congr_left fun c hc => ?_
    have e : firstNZ (namedComb q) c = firstNZ (namedComb q) (typeRep c) :=
      firstNZ_congr fun s _ hs => namedComb_type q hc hs
    simp only [Function.comp_apply, e]
  rw [primeCost, h1, unitsList_typeRep]
  simp only [unitTypes, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  ring

