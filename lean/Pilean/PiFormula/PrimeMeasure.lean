      + (1 / 2) * q 5 + 1 * q 6 + (-3 / 2) * q 7 := by
  have h : namedA1 1 = (1 / 2) ∧ namedA6 1 = (1 / 2) ∧ namedA10 1 = 1 ∧ namedL6 1 = (1 / 2)
     ∧ namedL8 1 = 1 ∧ namedL10 1 = (1 / 2) ∧ namedL24 1 = 1 ∧ namedTW 1 = (-3 / 2) := by
    decide +kernel
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp only [namedComb, h0, h1, h2, h3, h4, h5, h6, h7]
  ring

