  have e2 : namedComb q 14 = namedComb q 2 := h 2
  rw [namedComb_at_14, namedComb_at_2] at e2
  have e3 : namedComb q 15 = namedComb q 3 := h 3
  rw [namedComb_at_15, namedComb_at_3] at e3
