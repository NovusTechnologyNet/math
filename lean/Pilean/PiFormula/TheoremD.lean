  have e3 := h 3 (by decide)
  rw [namedComb_at_3] at e3
  have e5 := h 5 (by decide)
  rw [namedComb_at_5] at e5
  have e7 := h 7 (by decide)
  rw [namedComb_at_7] at e7
  have e9 := h 9 (by decide)
  rw [namedComb_at_9] at e9
  have e11 := h 11 (by decide)
  rw [namedComb_at_11] at e11
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination 2 * hv + (-2 / 3) * e1 + (-1 / 3) * e3 + (2 / 3) * e7 + (-1 / 3) * e9
  · linear_combination (1 / 3) * e1 + (-1 / 3) * e3 + (-1 / 3) * e7 + (-1 / 3) * e9
