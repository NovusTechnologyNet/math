    namedComb q 64 = 3 * q 3 + 5 * q 5 + 6 * q 6 + 9 * q 7 := by
  have h : namedA1 64 = 0 ∧ namedA6 64 = 0 ∧ namedA10 64 = 0 ∧ namedL6 64 = 3 ∧ namedL8 64 = 0 ∧
      namedL10 64 = 5 ∧ namedL24 64 = 6 ∧ namedTW 64 = 9 := by
    decide +kernel
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp only [namedComb, h0, h1, h2, h3, h4, h5, h6, h7]
  ring

theorem namedComb_at_65 (q : Fin 8 → ℚ) :
    namedComb q 65 = (1 / 2) * q 0 + (1 / 2) * q 1 + (-3 / 2) * q 2 + (1 / 2) * q 3
      + 1 * q 4 + 3 * q 5 + 1 * q 6 + (3 / 2) * q 7 := by
  have h : namedA1 65 = (1 / 2) ∧ namedA6 65 = (1 / 2) ∧ namedA10 65 = (-3 / 2) ∧
      namedL6 65 = (1 / 2) ∧ namedL8 65 = 1 ∧ namedL10 65 = 3 ∧ namedL24 65 = 1 ∧
      namedTW 65 = (3 / 2) := by
    decide +kernel
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp only [namedComb, h0, h1, h2, h3, h4, h5, h6, h7]
  ring

theorem namedComb_at_66 (q : Fin 8 → ℚ) :
    namedComb q 66 = 1 * q 0 + 2 * q 1 + (-2) * q 2 + (-2) * q 4
      + 2 * q 6 := by
  have h : namedA1 66 = 1 ∧ namedA6 66 = 2 ∧ namedA10 66 = (-2) ∧ namedL6 66 = 0 ∧
      namedL8 66 = (-2) ∧ namedL10 66 = 0 ∧ namedL24 66 = 2 ∧ namedTW 66 = 0 := by
    decide +kernel
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp only [namedComb, h0, h1, h2, h3, h4, h5, h6, h7]
  ring

/-! ## 3. What each condition forces on the coordinates (generated) -/

/-- The coordinates of a zero relation of period 8. -/
theorem coords_p8 (q : Fin 8 → ℚ) (hv : q 0 + q 2 = 0)
    (h : ∀ k, namedComb q (k + 8) = namedComb q k) :
    q 0 = 0 ∧ q 1 = 0 ∧ q 2 = 0 ∧ q 3 = 0 ∧ q 5 = 0 ∧ q 6 = 0 ∧ q 7 = 0 := by
  have e1 : namedComb q 9 = namedComb q 1 := h 1
  rw [namedComb_at_9, namedComb_at_1] at e1
  have e2 : namedComb q 10 = namedComb q 2 := h 2
  rw [namedComb_at_10, namedComb_at_2] at e2
  have e3 : namedComb q 11 = namedComb q 3 := h 3
  rw [namedComb_at_11, namedComb_at_3] at e3
  have e4 : namedComb q 12 = namedComb q 4 := h 4
  rw [namedComb_at_12, namedComb_at_4] at e4
  have e5 : namedComb q 13 = namedComb q 5 := h 5
  rw [namedComb_at_13, namedComb_at_5] at e5
  have e6 : namedComb q 14 = namedComb q 6 := h 6
  rw [namedComb_at_14, namedComb_at_6] at e6
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · linear_combination 1 * hv + (-2 / 5) * e1 + (-1 / 5) * e2 + (1 / 5) * e4 + (-1 / 5) * e6
  · linear_combination (-1 / 6) * e1 + (1 / 3) * e3 + (-1 / 12) * e4 + (1 / 12) * e6
  · linear_combination (2 / 5) * e1 + (1 / 5) * e2 + (-1 / 5) * e4 + (1 / 5) * e6
  · linear_combination (1 / 3) * e1 + (1 / 3) * e3
  · linear_combination (1 / 5) * e1 + (1 / 5) * e2 + (-1 / 10) * e4 + (2 / 5) * e5 + (1 / 10) * e6
  · linear_combination (1 / 12) * e1 + (1 / 6) * e3 + (-1 / 8) * e4 + (-1 / 24) * e6
  · linear_combination (1 / 6) * e1 + (-1 / 12) * e4 + (1 / 12) * e6

