      + (5 / 12) * e3 + (-5 / 16) * e4 + (7 / 12) * e5 + (-5 / 24) * e6
  · linear_combination (-1 / 12) * hv + (1 / 8) * e1 + (-49 / 144) * e2
      + (3 / 4) * e3 + (-11 / 16) * e4 + (5 / 4) * e5 + (-35 / 72) * e6

/-- The coordinates of a zero relation of period 24. -/
theorem coords_p24 (q : Fin 8 → ℚ) (hv : q 0 + q 2 = 0)
    (h : ∀ k, namedComb q (k + 24) = namedComb q k) :
    q 0 = 0 ∧ q 2 = 0 ∧ q 5 = 0 := by
  have e1 : namedComb q 25 = namedComb q 1 := h 1
