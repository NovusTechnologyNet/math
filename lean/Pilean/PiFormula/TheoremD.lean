/-- A zero relation supported on even `k` is a multiple of `namedL24 - namedL8`. -/
theorem coords_even (q : Fin 8 → ℚ) (hv : q 0 + q 2 = 0)
    (h : ∀ k, k % 2 = 1 → namedComb q k = 0) :
    q 0 = 0 ∧ q 1 = 0 ∧ q 2 = 0 ∧ q 3 = 0 ∧ q 5 = 0 ∧ q 7 = 0 ∧ q 4 + q 6 = 0 := by
  have e1 := h 1 (by decide)
