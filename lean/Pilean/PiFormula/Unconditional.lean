import Pilean.PiFormula.All
import Baker.Basic

/-!
# The main theorems, without a hypothesis

Part III proves its theorems from `BakerTheorem : Prop`, Baker's theorem on linear forms in
logarithms stated as a hypothesis. `Baker/` holds a formal proof of Baker's theorem
(`Transcendental.baker`, by Michail Karatarakis, Apache License 2.0; see `Baker/README.md`).
`bakerTheorem` below feeds it through `bakerTheorem_of_linearIndependent`, and the rest of
the file restates the main theorems with the hypothesis removed.

This file is generated by `scripts/unconditional_gen.py`: each statement is the original
with `(hB : BakerTheorem)` deleted, and each proof is the original applied to `bakerTheorem`.
-/

open Complex

namespace PiFormula

/-- **Baker's theorem**, in the form used throughout Part III. -/
theorem bakerTheorem : BakerTheorem :=
  bakerTheorem_of_linearIndependent fun hl hli _ _ hβ₀ hβ hrel =>
    Transcendental.baker hl hli hβ₀ hβ hrel

namespace Unconditional

/-- **Theorem C, rational case.** The patterns of period `N` (`120 ∣ N`) whose series is a
rational multiple of `π` form a space of dimension exactly 8. -/
theorem finrank_ratSpace {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) :
    Module.finrank ℚ (ratSpace N) = 8 :=
  _root_.PiFormula.finrank_ratSpace bakerTheorem hN h120

/-- **Theorem C, algebraic case.** The patterns whose series is an algebraic multiple of `π`
form a space of dimension exactly 13. -/
theorem finrank_algSpace {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) :
    Module.finrank ℚ (algSpace N) = 13 :=
  _root_.PiFormula.finrank_algSpace bakerTheorem hN h120

/-- **Theorem C.** Both dimensions together. -/
theorem theoremC {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) :
    (∀ ρ ∈ algSpace N, ∀ k, ρ (k + 120) = ρ k) ∧
      Module.finrank ℚ (algSpace N) = 13 ∧ Module.finrank ℚ (ratSpace N) = 8 :=
  _root_.PiFormula.theoremC bakerTheorem hN h120

/-- **The value formula.** The value of a series of the 8-dimensional space, from six of its
coefficients. -/
theorem value_formula {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) {ρ : ℕ → ℚ}
    (hρ : ρ ∈ ratSpace N) :
    HasSum (seriesTerm ρ)
      (((7 / 12 * ρ 1 + 1 / 8 * ρ 2 + 1 / 6 * ρ 3 - 7 / 12 * ρ 7 + 1 / 6 * ρ 9
        - 1 / 8 * ρ 14 : ℚ) : ℝ) * (Real.pi / 4)) :=
  _root_.PiFormula.value_formula bakerTheorem hN h120 hρ

/-- **Theorem D, sharp form.** A pattern with no term at any `k` with `gcd(k, 120) < 4` whose
series is a rational multiple of `π` is a multiple of one fixed zero relation. -/
theorem theoremD_sharp {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) {ρ : ℕ → ℚ}
    (hρ : ρ ∈ ratSpace N) (hsupp : ∀ k, Nat.gcd k 120 < 4 → ρ k = 0) :
    ∃ c : ℚ, ρ = c • zD :=
  _root_.PiFormula.theoremD_sharp bakerTheorem hN h120 hρ hsupp

/-- **Theorem D for algebraic multiples of `π`**, sharp form. -/
theorem theoremD_alg_sharp {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N)
    {ρ : ℕ → ℚ} (hρ : ρ ∈ algSpace N) (hsupp : ∀ k, Nat.gcd k 120 < 4 → ρ k = 0) :
    ∃ c : ℚ, ρ = c • zD :=
  _root_.PiFormula.theoremD_alg_sharp bakerTheorem hN h120 hρ hsupp

/-- **Bailey's table, family `n = 2B`.** The number of independent zero relations of
`P(1, 2^B, 2B, ·)`, for every `B`. -/
theorem bailey_count_F2 {B : ℕ} (hB0 : 0 < B) :
    Module.finrank ℚ (baileyZero B (2 * B)) = zeroCount (Nat.gcd (2 * B) 120) :=
  _root_.PiFormula.bailey_count_F2 bakerTheorem hB0

/-- **Bailey's table, family `n = B`.** The number of independent zero relations of
`P(1, 2^B, B, ·)`, for every `B`. -/
theorem bailey_count_F1 {B : ℕ} (hB0 : 0 < B) :
    Module.finrank ℚ (baileyZero B B) = if 6 ∣ B then 1 else 0 :=
  _root_.PiFormula.bailey_count_F1 bakerTheorem hB0

/-- **Bailey's table**, the 27 rows of degree 1 in base `2^B`. -/
theorem bailey_table :
    ∀ r ∈ ([(4, 8, 1), (6, 6, 1), (8, 16, 1), (12, 12, 1), (12, 24, 5), (16, 32, 1),
      (18, 18, 1), (20, 40, 3), (24, 24, 1), (24, 48, 5), (28, 56, 1), (30, 30, 1), (30, 60, 1),
      (32, 64, 1), (36, 36, 1), (36, 72, 5), (40, 80, 3), (42, 42, 1), (42, 84, 1), (44, 88, 1),
      (48, 48, 1), (48, 96, 5), (52, 104, 1), (54, 54, 1), (56, 112, 1), (60, 60, 1),
      (60, 120, 7)] : List (ℕ × ℕ × ℕ)),
      Module.finrank ℚ (baileyZero r.1 r.2.1) = r.2.2 :=
  _root_.PiFormula.bailey_table bakerTheorem

/-- **Theorem E.** A formula for a non-zero rational multiple of `π` has at least 40 non-zero
coefficients per 120 (2/3 of a term per bit) and prime cost at least 7/24. -/
theorem theoremE {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) {ρ : ℕ → ℚ}
    (hp : ∀ k, ρ (k + N) = ρ k) {r : ℚ} (hr : r ≠ 0)
    (h : HasSum (seriesTerm ρ) (r * Real.pi)) : 40 ≤ termCount ρ ∧ 7 / 24 ≤ primeCost ρ :=
  _root_.PiFormula.theoremE bakerTheorem hN h120 hp hr h

/-- **Theorem G.** No series of the class F is a non-zero algebraic multiple of `log 23`. -/
theorem no_log23 {N : ℕ} (hN : 0 < N) (h8 : 8 ∣ N) {ρ : ℕ → ℚ}
    (hρ : ∀ k, ρ (k + N) = ρ k) {q : ℝ} (hq : IsAlgebraic ℚ q)
    (h : HasSum (seriesTerm ρ) (q * Real.log 23)) : q = 0 :=
  _root_.PiFormula.no_log23 bakerTheorem hN h8 hρ hq h

/-- **Theorem G** for `P(1, 2^B, 2B, A)`, every `B ≥ 1`. -/
theorem bailey_no_log23_F2 {B : ℕ} (hB0 : 0 < B) (a : Fin (2 * B) → ℚ)
    {q : ℝ} (hq : IsAlgebraic ℚ q) (h : HasSum (baileyBlock B (2 * B) a) (q * Real.log 23)) :
    q = 0 :=
  _root_.PiFormula.bailey_no_log23_F2 bakerTheorem hB0 a hq h

/-- **Theorem G** for `P(1, 2^B, B, A)`, every `B ≥ 1`. -/
theorem bailey_no_log23_F1 {B : ℕ} (hB0 : 0 < B) (a : Fin B → ℚ)
    {q : ℝ} (hq : IsAlgebraic ℚ q) (h : HasSum (baileyBlock B B a) (q * Real.log 23)) :
    q = 0 :=
  _root_.PiFormula.bailey_no_log23_F1 bakerTheorem hB0 a hq h

/-- **Ten primes with no formula.** For `ℓ = 23, 47, 53, 59, 67, 71, 79, 83, 89, 97`, `log ℓ`
is not a value of the class F. -/
theorem not_isFValue_log_of_mem {ℓ : ℕ} (hℓ : ℓ ∈ noLogPrimes) :
    ¬ IsFValue (Real.log ℓ) :=
  _root_.PiFormula.not_isFValue_log_of_mem bakerTheorem hℓ

/-- **Theorem H.** For a prime `p < 100`, `log p` is a value of the class F if and only if
`p` is one of `2, 3, 5, 7, 11, 13, 17, 19, 29, 31, 37, 41, 43, 61, 73`. -/
theorem log_primes_below_100 {p : ℕ} (hp : p.Prime) (h100 : p < 100) :
    IsFValue (Real.log p) ↔ p ∈ logPrimes :=
  _root_.PiFormula.log_primes_below_100 bakerTheorem hp h100

/-- **Theorem I.** No series of the class F is a non-zero algebraic multiple of
`arctan (2/7)`. -/
theorem no_arctan_two_sevenths {N : ℕ} (hN : 0 < N) {ρ : ℕ → ℚ}
    (hρ : ∀ k, ρ (k + N) = ρ k) {q : ℝ} (hq : IsAlgebraic ℚ q)
    (h : HasSum (seriesTerm ρ) (q * Real.arctan (2 / 7))) : q = 0 :=
  _root_.PiFormula.no_arctan_two_sevenths bakerTheorem hN hρ hq h

/-- **Theorem I.** `arctan (2/7)` is not a value of the class F. -/
theorem not_isFValue_arctan_two_sevenths :
    ¬ IsFValue (Real.arctan (2 / 7)) :=
  _root_.PiFormula.not_isFValue_arctan_two_sevenths bakerTheorem

/-- `arctan (5/8)` is not a value of the class F. -/
theorem not_isFValue_arctan_five_eighths :
    ¬ IsFValue (Real.arctan (5 / 8)) :=
  _root_.PiFormula.not_isFValue_arctan_five_eighths bakerTheorem

/-- `arctan (4/9)` is not a value of the class F. -/
theorem not_isFValue_arctan_four_ninths :
    ¬ IsFValue (Real.arctan (4 / 9)) :=
  _root_.PiFormula.not_isFValue_arctan_four_ninths bakerTheorem

/-- **Theorem I** for `P(1, 2^B, 2B, A)`, every `B ≥ 1`. -/
theorem bailey_no_arctan_two_sevenths_F2 {B : ℕ} (hB0 : 0 < B)
    (a : Fin (2 * B) → ℚ) {q : ℝ} (hq : IsAlgebraic ℚ q)
    (h : HasSum (baileyBlock B (2 * B) a) (q * Real.arctan (2 / 7))) : q = 0 :=
  _root_.PiFormula.bailey_no_arctan_two_sevenths_F2 bakerTheorem hB0 a hq h

/-- **Theorem I** for `P(1, 2^B, B, A)`, every `B ≥ 1`. -/
theorem bailey_no_arctan_two_sevenths_F1 {B : ℕ} (hB0 : 0 < B)
    (a : Fin B → ℚ) {q : ℝ} (hq : IsAlgebraic ℚ q)
    (h : HasSum (baileyBlock B B a) (q * Real.arctan (2 / 7))) : q = 0 :=
  _root_.PiFormula.bailey_no_arctan_two_sevenths_F1 bakerTheorem hB0 a hq h

/-- **Theorem J.** Two different formulas of the class F with the same non-zero rational
multiple of `π` as value cost at least 60 terms per 60 bits as a checked pair. -/
theorem pairCost_ge {N : ℕ} (hN : 0 < N) (h120 : 120 ∣ N) {ρ₁ ρ₂ : ℕ → ℚ}
    (hp₁ : ∀ k, ρ₁ (k + N) = ρ₁ k) (hp₂ : ∀ k, ρ₂ (k + N) = ρ₂ k) {r : ℚ} (hr : r ≠ 0)
    (h₁ : HasSum (seriesTerm ρ₁) (r * Real.pi)) (h₂ : HasSum (seriesTerm ρ₂) (r * Real.pi))
    (hne : ρ₁ ≠ ρ₂) : 60 ≤ pairCost ρ₁ ρ₂ :=
  _root_.PiFormula.pairCost_ge bakerTheorem hN h120 hp₁ hp₂ hr h₁ h₂ hne

/-- **Theorem J**, with Takahashi's pair, which attains the bound. -/
theorem checkedPair :
    (∀ {N : ℕ}, 0 < N → 120 ∣ N → ∀ {ρ₁ ρ₂ : ℕ → ℚ}, (∀ k, ρ₁ (k + N) = ρ₁ k) →
      (∀ k, ρ₂ (k + N) = ρ₂ k) → ∀ {r : ℚ}, r ≠ 0 → HasSum (seriesTerm ρ₁) (r * Real.pi) →
      HasSum (seriesTerm ρ₂) (r * Real.pi) → ρ₁ ≠ ρ₂ → 60 ≤ pairCost ρ₁ ρ₂) ∧
    HasSum (seriesTerm rhoTak1) Real.pi ∧ HasSum (seriesTerm rhoTak2) Real.pi ∧
      pairCost rhoTak1 rhoTak2 = 60 :=
  _root_.PiFormula.checkedPair bakerTheorem

end Unconditional

end PiFormula
