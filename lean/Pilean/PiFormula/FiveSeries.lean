theorem psS3_eq (k : ℕ) : psS3 k = ((PS3Z k : GaussianInt) : ℂ) := by
  rw [psS3_reduce, PS3Z]
  exact psS3_small (k % 24) (Nat.mod_lt _ (by norm_num))

/-- The coefficients of `psS3` and the exponents of `ζ_120`. -/
noncomputable def LS3 : List (ℝ × ℕ) :=
  [(Real.sqrt 3, 20), (-Real.sqrt 3, 100)]

theorem lsum_LS3 (k : ℕ) : lsum LS3 k = psS3 k := by
  simp only [lsum, LS3, psS3, z24, ← pow_mul, Nat.reduceMul, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil]
  push_cast
  ring

/-- The table of the power sum `psS2`, of period 24. -/
def tabS2 : List GaussianInt :=
  [⟨0, 0⟩, ⟨-4, 4⟩, ⟨0, 0⟩, ⟨-2, -2⟩, ⟨0, 0⟩, ⟨4, -4⟩, ⟨0, 0⟩, ⟨-4, -4⟩, ⟨0, 0⟩, ⟨2, -2⟩, ⟨0, 0⟩,
   ⟨4, 4⟩, ⟨0, 0⟩, ⟨4, -4⟩, ⟨0, 0⟩, ⟨2, 2⟩, ⟨0, 0⟩, ⟨-4, 4⟩, ⟨0, 0⟩, ⟨4, 4⟩, ⟨0, 0⟩, ⟨-2, 2⟩,
   ⟨0, 0⟩, ⟨-4, -4⟩]

def PS2Z (k : ℕ) : GaussianInt := tabS2.getD (k % 24) 0

/-- The power sum of the series `S2`: real coefficients times roots of unity. -/
noncomputable def psS2 (k : ℕ) : ℂ :=
  (Real.sqrt 2 : ℂ) * ((z24 ^ 9) ^ k - (z24 ^ 21) ^ k - (z24 ^ 1) ^ k + (z24 ^ 5) ^ k
    + (z24 ^ 13) ^ k - (z24 ^ 17) ^ k)

theorem psS2_reduce (k : ℕ) : psS2 k =
    (Real.sqrt 2 : ℂ) * (z24 ^ (9 * (k % 24) % 24) - z24 ^ (21 * (k % 24) % 24)
      - z24 ^ (1 * (k % 24) % 24) + z24 ^ (5 * (k % 24) % 24) + z24 ^ (13 * (k % 24) % 24)
      - z24 ^ (17 * (k % 24) % 24)) := by
  simp only [psS2, ← pow_mul]
  rw [z24_pow_mod (9 * k), z24_pow_mod (21 * k), z24_pow_mod (1 * k), z24_pow_mod (5 * k),
    z24_pow_mod (13 * k), z24_pow_mod (17 * k), Nat.mul_mod 9, Nat.mul_mod 21, Nat.mul_mod 1,
    Nat.mul_mod 5, Nat.mul_mod 13, Nat.mul_mod 17]

theorem psS2_small : ∀ r < 24,
    (Real.sqrt 2 : ℂ) * (z24 ^ (9 * r % 24) - z24 ^ (21 * r % 24) - z24 ^ (1 * r % 24)
      + z24 ^ (5 * r % 24) + z24 ^ (13 * r % 24) - z24 ^ (17 * r % 24)) =
      ((tabS2.getD r 0 : GaussianInt) : ℂ) := by
  intro r hr
  interval_cases r
  · simp only [Nat.reduceMul, Nat.reduceMod]
    rw [show tabS2.getD 0 0 = (⟨0, 0⟩ : GaussianInt) from rfl,
      GaussianInt.toComplex_def', I_z24, sqrt2_eq]
    push_cast
    linear_combination (0) * cyc24
  · simp only [Nat.reduceMul, Nat.reduceMod]
    rw [show tabS2.getD 1 0 = (⟨-4, 4⟩ : GaussianInt) from rfl,
      GaussianInt.toComplex_def', I_z24, sqrt2_eq]
    push_cast
    linear_combination (-z24 ^ 34 - 2 * z24 ^ 30 + 3 * z24 ^ 22 + 4 * z24 ^ 18 - z24 ^ 16
      - 2 * z24 ^ 12 - 4 * z24 ^ 10 - 4 * z24 ^ 6 + 3 * z24 ^ 4 + 4) * cyc24
