   ⟨0, -3⟩, ⟨0, 0⟩, ⟨0, 3⟩, ⟨0, 3⟩, ⟨0, 0⟩, ⟨0, -3⟩, ⟨0, -3⟩, ⟨0, 0⟩, ⟨0, 3⟩, ⟨0, 3⟩, ⟨0, 0⟩,
   ⟨0, -3⟩, ⟨0, -3⟩]

def PS3Z (k : ℕ) : GaussianInt := tabS3.getD (k % 24) 0

/-- The power sum of the series `S3`: real coefficients times roots of unity. -/
noncomputable def psS3 (k : ℕ) : ℂ :=
  (Real.sqrt 3 : ℂ) * ((z24 ^ 4) ^ k - (z24 ^ 20) ^ k)

theorem psS3_reduce (k : ℕ) : psS3 k =
    (Real.sqrt 3 : ℂ) * (z24 ^ (4 * (k % 24) % 24) - z24 ^ (20 * (k % 24) % 24)) := by
  simp only [psS3, ← pow_mul]
  rw [z24_pow_mod (4 * k), z24_pow_mod (20 * k), Nat.mul_mod 4, Nat.mul_mod 20]

theorem psS3_small : ∀ r < 24,
    (Real.sqrt 3 : ℂ) * (z24 ^ (4 * r % 24) - z24 ^ (20 * r % 24)) =
