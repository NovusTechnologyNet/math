    ((-1 / 2 : ℚ) : ℂ) * (Real.pi * I) := by
  have h := log_exact (isRelJ_comp rel1_isRel (a := 1) (b := 1) (by norm_num)
    (by norm_num) maps_1 maps_1 inv_1_1 inv_1_1)
    (by decide +kernel) (by decide +kernel)
  have hv : (∑ j ∈ R0Exps, ((rel1 (1 * j % 120) : ℤ) : ℚ) * alpha j) = -1 / 2 := by
    decide +kernel
  rw [hv] at h
  exact h

