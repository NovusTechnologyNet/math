/-- The conjugated logarithm sum for `b = 1`, for a coefficient vector `c`. -/
theorem conjlog_1 (c : Fin 13 → ℂ) :
    ∑ j ∈ R0Exps, combC c (1 * j % 120) * Complex.log (wJ j) =
      (c 0 * (-1 / 2) + c 1 * (-1 / 2) + c 2 * (-1 / 2) + c 3 * (-1 / 2) + c 4 * (1 / 3)
      + c 5 * (-5 / 6) + c 6 * (-11 / 10) + c 7 * (-39 / 10) + c 8 * (-7 / 10)
      + c 9 * (17 / 10) + c 10 * (-4 / 3) + c 11 * (-1 / 6) + c 12 * (1 / 4)) * (Real.pi * I) := by
  have h := sum_combC_comp c R0Exps (fun j => 1 * j % 120) (fun j => Complex.log (wJ j))
  beta_reduce at h
  rw [h, lf_1_1, lf_1_2, lf_1_3, lf_1_4, lf_1_5, lf_1_6, lf_1_7,
    lf_1_8, lf_1_9, lf_1_10, lf_1_11, lf_1_12, lf_1_13]
  push_cast
  ring

