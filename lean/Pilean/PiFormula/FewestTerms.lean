module

public import Pilean.PiFormula.Classes

/-!
# Theorem E, the standard measure: at least 40 terms per period (rate 2/3)

`termCount ρ` is the number of non-zero entries of a pattern in one period of 120. The cost
of the classical BBP algorithm is `termCount / 60` terms per bit.

* `termCount_ge` (from Baker's theorem): every series of the class F whose value is a
  non-zero rational multiple of `π` has at least 40 non-zero entries per period, that is, at
  least `2/3` terms per bit.

The proof is a branch-and-bound tree on the 35 classes of zero conditions
(theorem_e_experiment.py), checked by a small verified checker:

* a certificate (`Cert`) is a tree; a `branch` node splits on "class `i` vanishes or not"; a
  `derive` node proves that a class cannot vanish, from an integer linear identity (if it
  vanished, with the classes already assumed to vanish, then the value or a class known to be
  non-zero would vanish); a `done` leaf counts the positions whose class is known to be
  non-zero, and needs at least 40;
* `checkCert` checks a certificate by integer arithmetic, and `checkCert_sound` proves that
  a certificate that passes gives the bound;
* the certificate itself (section 3) is generated by scripts/egen.py and checked by
  `decide +kernel`.
-/

@[expose] public section

open Complex

namespace PiFormula

/-! ## 1. Certificates and the checker -/

/-- The number of non-zero entries in one period of 120. -/
def termCount (ρ : ℕ → ℚ) : ℕ := (List.range 120).countP fun k => decide (ρ k ≠ 0)

/-- A certificate tree for a lower bound on `termCount`. -/
inductive Cert where
  | done : Cert
  | derive (j tgt : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) (rest : Cert) : Cert
  | branch (i : ℕ) (zero nz : Cert) : Cert

/-- The vector of a target: the value `q 0 + q 2` for the index 35, a class form otherwise. -/
def tgtVec (tgt t : ℕ) : ℤ :=
  if tgt = 35 then ([1, 0, 1, 0, 0, 0, 0, 0] : List ℤ).getD t 0 else vecZ tgt t

/-- The integer identity `d · target = ∑ c · (class vector)`, coordinate by coordinate. -/
def certEq (tgt : ℕ) (d : ℤ) (cs : List (ℕ × ℤ)) : Bool :=
  (List.range 8).all fun t => d * tgtVec tgt t == (cs.map fun p => p.2 * vecZ p.1 t).sum

/-- The checker. `Z` lists the classes assumed to vanish, `D` those known not to vanish. -/
def checkCert : List ℕ → List ℕ → Cert → Bool
  | _, D, .done => decide (40 ≤ clsIdxTab.countP fun i => D.contains i)
  | Z, D, .derive j tgt d cs rest =>
      (d != 0) && (tgt == 35 || D.contains tgt) && (cs.all fun p => p.1 == j || Z.contains p.1)
        && certEq tgt d cs && checkCert Z (j :: D) rest
  | Z, D, .branch i t0 t1 => checkCert (i :: Z) D t0 && checkCert Z (i :: D) t1

/-! ## 2. Soundness -/

theorem clsIdxTab_eq : clsIdxTab = (List.range 120).map clsIdx := by decide +kernel

/-- A linear form in `q` with integer coefficients `f 0, ..., f 7`. -/
def lin8 (f : ℕ → ℤ) (q : Fin 8 → ℚ) : ℚ :=
  (f 0 : ℚ) * q 0 + f 1 * q 1 + f 2 * q 2 + f 3 * q 3 + f 4 * q 4 + f 5 * q 5 + f 6 * q 6
    + f 7 * q 7

theorem clsForm_eq_lin8 (i : ℕ) (q : Fin 8 → ℚ) : clsForm i q = lin8 (vecZ i) q := rfl

theorem lin8_congr {f g : ℕ → ℤ} (h : ∀ t < 8, f t = g t) (q : Fin 8 → ℚ) :
    lin8 f q = lin8 g q := by
  simp only [lin8, h 0 (by norm_num), h 1 (by norm_num), h 2 (by norm_num), h 3 (by norm_num),
    h 4 (by norm_num), h 5 (by norm_num), h 6 (by norm_num), h 7 (by norm_num)]

theorem lin8_sum (cs : List (ℕ × ℤ)) (q : Fin 8 → ℚ) :
    lin8 (fun t => (cs.map fun p => p.2 * vecZ p.1 t).sum) q =
      (cs.map fun p => (p.2 : ℚ) * clsForm p.1 q).sum := by
  induction cs with
  | nil => simp [lin8]
  | cons p cs ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [← ih]
    simp only [lin8, clsForm]
    push_cast
    ring

/-- The linear form of a target. -/
def tgtForm (tgt : ℕ) (q : Fin 8 → ℚ) : ℚ := lin8 (tgtVec tgt) q

theorem tgtForm_35 (q : Fin 8 → ℚ) : tgtForm 35 q = q 0 + q 2 := by
  have h : tgtVec 35 0 = 1 ∧ tgtVec 35 1 = 0 ∧ tgtVec 35 2 = 1 ∧ tgtVec 35 3 = 0 ∧
      tgtVec 35 4 = 0 ∧ tgtVec 35 5 = 0 ∧ tgtVec 35 6 = 0 ∧ tgtVec 35 7 = 0 := by decide
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp only [tgtForm, lin8, h0, h1, h2, h3, h4, h5, h6, h7]
  push_cast
  ring

theorem tgtForm_of_ne {tgt : ℕ} (h : tgt ≠ 35) (q : Fin 8 → ℚ) :
    tgtForm tgt q = clsForm tgt q := by
  rw [tgtForm, clsForm_eq_lin8]
  exact lin8_congr (fun t _ => by simp only [tgtVec, h, ↓reduceIte]) q

/-- A certificate identity that passes the check holds for the linear forms. -/
theorem certEq_sound {tgt : ℕ} {d : ℤ} {cs : List (ℕ × ℤ)} (h : certEq tgt d cs = true)
    (q : Fin 8 → ℚ) :
    (d : ℚ) * tgtForm tgt q = (cs.map fun p => (p.2 : ℚ) * clsForm p.1 q).sum := by
  rw [← lin8_sum]
  have h8 : ∀ t < 8, d * tgtVec tgt t = (cs.map fun p => p.2 * vecZ p.1 t).sum := by
    intro t ht
    have h1 := List.all_eq_true.1 h t (List.mem_range.2 ht)
    exact eq_of_beq h1
  rw [← lin8_congr h8 q]
  simp only [tgtForm, lin8]
  push_cast
  ring

/-- **The checker is sound.** If a certificate passes, every pattern of `V` with non-zero
value, whose classes in `Z` vanish and whose classes in `D` do not, has at least 40 non-zero
entries per period. -/
theorem checkCert_sound (q : Fin 8 → ℚ) (hV : q 0 + q 2 ≠ 0) : ∀ (c : Cert) (Z D : List ℕ),
    checkCert Z D c = true → (∀ z ∈ Z, clsForm z q = 0) → (∀ e ∈ D, clsForm e q ≠ 0) →
    40 ≤ termCount (namedComb q) := by
  intro c
  induction c with
  | done =>
    intro Z D h _ hD
    have h1 : 40 ≤ clsIdxTab.countP fun i => D.contains i := of_decide_eq_true h
    rw [clsIdxTab_eq, List.countP_map] at h1
    refine h1.trans (List.countP_mono_left fun k _ hk => ?_)
    have hmem : clsIdx k ∈ D := List.elem_iff.1 hk
    have hne : namedComb q k ≠ 0 := fun h0 => hD _ hmem ((namedComb_eq_zero_iff q k).1 h0)
    exact decide_eq_true hne
  | derive j tgt d cs rest ih =>
    intro Z D h hZ hD
    simp only [checkCert, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨hd, htgt⟩, hcs⟩, heq⟩, hrest⟩ := h
    have hd' : (d : ℚ) ≠ 0 := by
      have h0 : d ≠ 0 := by simpa using hd
      exact_mod_cast h0
    have hj : clsForm j q ≠ 0 := by
      intro hj0
      have hsum : (cs.map fun p => (p.2 : ℚ) * clsForm p.1 q).sum = 0 := by
        refine List.sum_eq_zero fun x hx => ?_
        obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
        have hp1 := List.all_eq_true.1 hcs p hp
        have hp0 : clsForm p.1 q = 0 := by
          rcases Bool.or_eq_true_iff.1 hp1 with h1 | h1
          · rw [eq_of_beq h1]
            exact hj0
          · exact hZ _ (List.elem_iff.1 h1)
        rw [hp0, mul_zero]
      have h2 := certEq_sound heq q
      rw [hsum] at h2
      have h3 : tgtForm tgt q = 0 := by
        rcases mul_eq_zero.1 h2 with h3 | h3
        · exact absurd h3 hd'
        · exact h3
      rcases Bool.or_eq_true_iff.1 htgt with h4 | h4
      · have e : tgt = 35 := eq_of_beq h4
        rw [e, tgtForm_35] at h3
        exact hV h3
      · have hmem : tgt ∈ D := List.elem_iff.1 h4
        by_cases e : tgt = 35
        · rw [e, tgtForm_35] at h3
          exact hV h3
        · rw [tgtForm_of_ne e] at h3
          exact hD _ hmem h3
    refine ih Z (j :: D) hrest hZ fun e he => ?_
    rcases List.mem_cons.1 he with rfl | he
    · exact hj
    · exact hD e he
  | branch i t0 t1 ih0 ih1 =>
    intro Z D h hZ hD
    simp only [checkCert, Bool.and_eq_true] at h
    obtain ⟨h0, h1⟩ := h
    by_cases hi : clsForm i q = 0
    · refine ih0 (i :: Z) D h0 (fun z hz => ?_) hD
      rcases List.mem_cons.1 hz with rfl | hz
      · exact hi
      · exact hZ z hz
    · refine ih1 Z (i :: D) h1 hZ fun e he => ?_
      rcases List.mem_cons.1 he with rfl | he
      · exact hi
      · exact hD e he

