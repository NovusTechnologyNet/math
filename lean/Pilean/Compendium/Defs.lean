module

public import Pilean.BaseB.NegativeBase
public import Pilean.BaseB.Combination
public import Pilean.BaseB.LogSelf
public import Pilean.PiFormula.TheoremC3
public import Pilean.PiFormula.SharpD
public import Pilean.Base3.Bailey

/-!
# Bailey's Compendium of BBP-type formulas: the uniform statements

Bailey's notation is `P(s, β, N, A) = ∑_{j ≥ 0} β^(-j) ∑_{i=1}^{N} a_i / (N j + i)^s`. A formula
of degree `s = 1` of the Compendium reads `x = c · P(1, β, N, A)`: a constant `x`, a prefactor
`c`, a base `β`, a length `N` and an integer vector `A`. Here:

* `HasBaileyValue b B N a x`: the series `P(1, b^B, N, a)` converges to `x`
  (`BaseB.baileyBlock`);
* `HasBaileyValueInt β B N a x`: the same for an integer base `β`, possibly negative
  (`BaseB.baileyBlockInt`);
* `BaileyFormula x c b B N a`: `x = c · P(1, b^B, N, a)`, that is, the series converges and
  `c` times its sum is `x`; `BaileyFormulaInt x c β B N a` for an integer base.

A base printed as a number (`16`, `729`, `-4`) is written with the exponent `B = 1`; a base
printed as a power (`2^12`, `3^6`) with that exponent.

The formulas themselves are in the other files of this folder, one theorem `formula_N` for the
formula `(N)` of the Compendium: `Base2Pi`, `Base2Sqrt`, `Base2Zero`, `Base3`, `Logs`
(generated by `python/compendium_lean.py` from the ledger
`literature/bailey-compendium/ledger.json`), and `Series`, `Arctan`, `Base5` (written by hand).
`literature/bailey-compendium/LEAN_STATUS.md` lists every formula of degree 1.

The rest of the file is the toolbox of the proofs:

* `BaileyFormula.hasSum`, `BaileyFormula.value`, `baileyFormula_one_iff`: a formula as a
  statement about one convergent series;
* linearity (`HasBaileyValue.add`, `.sub`, `.smul`, `.of_eq`), unit vectors (`unitVec`,
  `baileyBlock_unitVec`) and the change of base `b^(j B) = (b^j)^B` (`HasBaileyValue.of_pow`,
  `.to_pow`);
* `HasBaileyValue.regroup`: `m` consecutive blocks form one block,
  `P(1, b^B, N, a) = P(1, b^(B m), m N, a')`, with the coefficients `regroupCoeff`;
* `hasBaileyValueInt_of_pair`: a series of base `β < 0` from its paired form in base `|β|`
  (the converse of `BaseB.hasSum_baileyBlockInt_pair`);
* `hasBaileyValue_F2`, `hasBaileyValue_F1`: a vector whose pattern in the class F is an
  explicit combination of the eight named patterns has the value `(q₀ + q₂) π/4`; the versions
  `_S` add the patterns `extraS2`, `extraS3`, `extraS5` (values `-√2 π`, `-π/√3`, `-√5 π`);
* `hasBaileyValue_step_one`: the series `∑_{k ≥ 1} g(k) b^(-k) / k` with
  `g(k) = ∑_{d ∣ k} c_d` (`listPat`), a combination of the logarithms `log (1 - b^(-d))`
  (`listVal`, `logTerm`, `logTerm_eq`).
-/

@[expose] public section

namespace PiFormula

namespace Compendium

open BaseB

/-! ## 1. The statements -/

/-- Bailey's series `P(1, b^B, N, a) = ∑_{j ≥ 0} b^(-B j) ∑_{i=1}^{N} a_i / (N j + i)` converges
to `x`. -/
def HasBaileyValue (b B N : ℕ) (a : Fin N → ℚ) (x : ℝ) : Prop :=
  HasSum (BaseB.baileyBlock b B N a) x

/-- The series `P(1, β^B, N, a)` with an integer base `β` (possibly negative) converges to
`x`. -/
def HasBaileyValueInt (β : ℤ) (B N : ℕ) (a : Fin N → ℚ) (x : ℝ) : Prop :=
  HasSum (baileyBlockInt β B N a) x

/-- A formula of the Compendium: `x = c · P(1, b^B, N, a)`. The series converges, and `c`
times its sum is `x`. -/
def BaileyFormula (x c : ℝ) (b B N : ℕ) (a : Fin N → ℚ) : Prop :=
  ∃ S : ℝ, HasBaileyValue b B N a S ∧ x = c * S

/-- A formula of the Compendium with an integer base `β` (possibly negative):
`x = c · P(1, β^B, N, a)`. -/
def BaileyFormulaInt (x c : ℝ) (β : ℤ) (B N : ℕ) (a : Fin N → ℚ) : Prop :=
  ∃ S : ℝ, HasBaileyValueInt β B N a S ∧ x = c * S

theorem HasBaileyValue.formula {b B N : ℕ} {a : Fin N → ℚ} {S : ℝ}
    (h : HasBaileyValue b B N a S) {x c : ℝ} (e : x = c * S) : BaileyFormula x c b B N a :=
  ⟨S, h, e⟩

theorem HasBaileyValueInt.formula {β : ℤ} {B N : ℕ} {a : Fin N → ℚ} {S : ℝ}
    (h : HasBaileyValueInt β B N a S) {x c : ℝ} (e : x = c * S) :
    BaileyFormulaInt x c β B N a :=
  ⟨S, h, e⟩

/-- A formula as one convergent series: `∑_j c · (block j) = x`. -/
theorem BaileyFormula.hasSum {x c : ℝ} {b B N : ℕ} {a : Fin N → ℚ}
    (h : BaileyFormula x c b B N a) : HasSum (fun j => c * BaseB.baileyBlock b B N a j) x := by
  obtain ⟨S, hS, rfl⟩ := h
  exact hS.mul_left c

/-- A formula with an integer base as one convergent series. -/
theorem BaileyFormulaInt.hasSum {x c : ℝ} {β : ℤ} {B N : ℕ} {a : Fin N → ℚ}
    (h : BaileyFormulaInt x c β B N a) : HasSum (fun j => c * baileyBlockInt β B N a j) x := by
  obtain ⟨S, hS, rfl⟩ := h
  exact hS.mul_left c

/-- With the prefactor 1 a formula is the value of the series. -/
theorem baileyFormula_one_iff {x : ℝ} {b B N : ℕ} {a : Fin N → ℚ} :
    BaileyFormula x 1 b B N a ↔ HasBaileyValue b B N a x := by
  constructor
  · rintro ⟨S, hS, rfl⟩
    rwa [one_mul]
  · exact fun h => ⟨x, h, (one_mul x).symm⟩

/-- The value of the series of a formula with a non-zero prefactor. -/
theorem BaileyFormula.value {x c : ℝ} {b B N : ℕ} {a : Fin N → ℚ}
    (h : BaileyFormula x c b B N a) (hc : c ≠ 0) : HasBaileyValue b B N a (x / c) := by
  obtain ⟨S, hS, rfl⟩ := h
  rwa [mul_div_cancel_left₀ S hc]

/-- For a base `β = b ≥ 0` the two statements agree. -/
theorem hasBaileyValueInt_natCast {b B N : ℕ} {a : Fin N → ℚ} {x : ℝ} :
    HasBaileyValueInt (b : ℤ) B N a x ↔ HasBaileyValue b B N a x := by
  rw [HasBaileyValueInt, baileyBlockInt_natCast, HasBaileyValue]

/-! ## 2. Linearity and change of base -/

/-- Bailey's block is additive in the coefficient vector. -/
theorem baileyBlock_add (b B N : ℕ) (a a' : Fin N → ℚ) (j : ℕ) :
    BaseB.baileyBlock b B N (a + a') j =
      BaseB.baileyBlock b B N a j + BaseB.baileyBlock b B N a' j := by
  simp only [BaseB.baileyBlock, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  push_cast
  ring

theorem HasBaileyValue.of_eq {b B N : ℕ} {a a' : Fin N → ℚ} {x x' : ℝ}
    (h : HasBaileyValue b B N a x) (ea : a' = a) (ex : x' = x) : HasBaileyValue b B N a' x' := by
  rw [ea, ex]
  exact h

theorem HasBaileyValue.add {b B N : ℕ} {a a' : Fin N → ℚ} {x x' : ℝ}
    (h : HasBaileyValue b B N a x) (h' : HasBaileyValue b B N a' x') :
    HasBaileyValue b B N (a + a') (x + x') := by
  have e : BaseB.baileyBlock b B N (a + a') =
      fun j => BaseB.baileyBlock b B N a j + BaseB.baileyBlock b B N a' j :=
    funext fun j => baileyBlock_add b B N a a' j
  rw [HasBaileyValue, e]
  exact HasSum.add h h'

theorem HasBaileyValue.smul {b B N : ℕ} {a : Fin N → ℚ} {x : ℝ} (r : ℚ)
    (h : HasBaileyValue b B N a x) : HasBaileyValue b B N (r • a) ((r : ℝ) * x) :=
  hasSum_baileyBlock_smul r h

theorem HasBaileyValue.sub {b B N : ℕ} {a a' : Fin N → ℚ} {x x' : ℝ}
    (h : HasBaileyValue b B N a x) (h' : HasBaileyValue b B N a' x') :
    HasBaileyValue b B N (a - a') (x - x') := by
  refine (h.add (h'.smul (-1))).of_eq ?_ ?_
  · rw [neg_one_smul, sub_eq_add_neg]
  · push_cast
    ring

/-- The base `a^j` with the exponent `B` is the base `a` with the exponent `j B`. -/
theorem HasBaileyValue.of_pow {a j B N : ℕ} {c : Fin N → ℚ} {x : ℝ}
    (h : HasBaileyValue a (j * B) N c x) : HasBaileyValue (a ^ j) B N c x := by
  rw [HasBaileyValue, baileyBlock_pow]
  exact h

/-- The base `a` with the exponent `j B` is the base `a^j` with the exponent `B`. -/
theorem HasBaileyValue.to_pow {a j B N : ℕ} {c : Fin N → ℚ} {x : ℝ}
    (h : HasBaileyValue (a ^ j) B N c x) : HasBaileyValue a (j * B) N c x := by
  rw [HasBaileyValue, ← baileyBlock_pow]
  exact h

/-- The vector with the entry 1 at the place `j` (`1 ≤ j ≤ n`) and 0 elsewhere. -/
def unitVec (n j : ℕ) : Fin n → ℚ := fun t => if (t : ℕ) + 1 = j then 1 else 0

/-- The block of a unit vector: `b^(-B k) / (n k + j)`. -/
theorem baileyBlock_unitVec (b B : ℕ) {n j : ℕ} (hj : 0 < j) (hjn : j ≤ n) (k : ℕ) :
    BaseB.baileyBlock b B n (unitVec n j) k =
      1 / (b : ℝ) ^ (B * k) / ((n * k + j : ℕ) : ℝ) :=
  baileyBlock_unit b B hj hjn k

/-- For the base 3, `baileyBlock` is the block of `Base3/Bailey.lean`. -/
theorem baileyBlock_three (B n : ℕ) (a : Fin n → ℚ) :
    BaseB.baileyBlock 3 B n a = Base3.baileyBlock3 B n a := by
  funext j
  simp only [BaseB.baileyBlock, Base3.baileyBlock3, Nat.cast_ofNat]

/-! ## 3. Regrouping: `m` blocks form one block -/

/-- A convergent series, summed in groups of `m` consecutive terms. -/
theorem hasSum_group {f : ℕ → ℝ} {x : ℝ} {m : ℕ} (hm : 0 < m) (h : HasSum f x) :
    HasSum (fun j : ℕ => ∑ t : Fin m, f (m * j + t)) x := by
  have : NeZero m := ⟨hm.ne'⟩
  have h2 : HasSum (f ∘ (Nat.divModEquiv m).symm) x :=
    (Equiv.hasSum_iff (Nat.divModEquiv m).symm).2 h
  refine h2.prod_fiberwise fun j => ?_
  have e : (∑ t : Fin m, f (m * j + t)) =
      ∑ t : Fin m, (f ∘ (Nat.divModEquiv m).symm) (j, t) := by
    refine Finset.sum_congr rfl fun t _ => ?_
    change f (m * j + t) = f (j * m + t)
    rw [mul_comm]
  rw [e]
  exact hasSum_fintype _

/-- The coefficients of `P(1, b^B, N, a)` read as `P(1, b^(B m), m N, ·)`: the entry at the
place `N t + i` (`t < m`, `i < N`) is `a_i / b^(B t)`. -/
def regroupCoeff (b B m : ℕ) {N : ℕ} (a : Fin N → ℚ) : Fin (m * N) → ℚ :=
  fun i => a (finProdFinEquiv.symm i).2 / (b : ℚ) ^ (B * ((finProdFinEquiv.symm i).1 : ℕ))

/-- A block of the regrouped series is the sum of `m` consecutive blocks. -/
theorem baileyBlock_regroup (b B m : ℕ) {N : ℕ} (a : Fin N → ℚ) (j : ℕ) :
    BaseB.baileyBlock b (B * m) (m * N) (regroupCoeff b B m a) j =
      ∑ t : Fin m, BaseB.baileyBlock b B N a (m * j + t) := by
  simp only [BaseB.baileyBlock]
  rw [← finProdFinEquiv.sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun i _ => ?_
  have e1 : ((m * N * j + ((finProdFinEquiv (t, i) : Fin (m * N)) : ℕ) + 1 : ℕ) : ℝ) =
      ((N * (m * j + t) + i + 1 : ℕ) : ℝ) := by
    congr 1
    rw [finProdFinEquiv_apply_val]
    ring
  rw [regroupCoeff, Equiv.symm_apply_apply, e1]
  dsimp only
  have e2 : (b : ℝ) ^ (B * (m * j + (t : ℕ))) =
      (b : ℝ) ^ (B * (t : ℕ)) * (b : ℝ) ^ (B * m * j) := by
    rw [← pow_add]
    congr 1
    ring
  rw [e2]
  push_cast
  ring

/-- **Regrouping.** `P(1, b^B, N, a) = P(1, b^(B m), m N, a')` with `a' = regroupCoeff b B m a`:
`m` consecutive blocks form one block. -/
theorem HasBaileyValue.regroup {b B N : ℕ} {a : Fin N → ℚ} {x : ℝ} {m : ℕ} (hm : 0 < m)
    (h : HasBaileyValue b B N a x) :
    HasBaileyValue b (B * m) (m * N) (regroupCoeff b B m a) x := by
  have e : BaseB.baileyBlock b (B * m) (m * N) (regroupCoeff b B m a) =
      fun j : ℕ => ∑ t : Fin m, BaseB.baileyBlock b B N a (m * j + t) :=
    funext fun j => baileyBlock_regroup b B m a j
  rw [HasBaileyValue, e]
  exact hasSum_group hm h

/-! ## 4. Negative bases -/

/-- The series `P(1, β^B, N, a)` converges absolutely for `|β| ≥ 2` and `B ≥ 1`. -/
theorem summable_baileyBlockInt {β : ℤ} (hβ : 2 ≤ β.natAbs) {B : ℕ} (hB : 0 < B) (N : ℕ)
    (a : Fin N → ℚ) : Summable (baileyBlockInt β B N a) := by
  have hβ2 : (2 : ℝ) ≤ |(β : ℝ)| := by
    have e : ((β.natAbs : ℕ) : ℝ) = |(β : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
    rw [← e]
    exact_mod_cast hβ
  have hpos : 0 < |(β : ℝ)| := by linarith
  have hr0 : 0 ≤ (|(β : ℝ)| ^ B)⁻¹ := by positivity
  have hr1 : (|(β : ℝ)| ^ B)⁻¹ < 1 :=
    inv_lt_one_of_one_lt₀ (one_lt_pow₀ (by linarith) hB.ne')
  have hgeo : Summable fun j : ℕ => (∑ i : Fin N, |(a i : ℝ)|) * ((|(β : ℝ)| ^ B)⁻¹) ^ j :=
    (summable_geometric_of_lt_one hr0 hr1).mul_left _
  refine Summable.of_norm_bounded hgeo fun j => ?_
  rw [baileyBlockInt, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  have hp : 0 < |(β : ℝ)| ^ (B * j) := by positivity
  have h1 : (1 : ℝ) ≤ ((N * j + i + 1 : ℕ) : ℝ) := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le _)
  rw [Real.norm_eq_abs, abs_div, abs_div, abs_pow, Nat.abs_cast, inv_pow, ← pow_mul,
    ← div_eq_mul_inv]
  exact div_le_self (div_nonneg (abs_nonneg _) hp.le) h1

/-- **A series of base `β` from its paired form in base `|β|`.** If
`P(1, |β|^(2B), 2N, a')` has the value `x`, where `a' = intPairCoeff β B a` (`a'_i = a_i` and
`a'_(N+i) = a_i / β^B`), then `P(1, β^B, N, a) = x`. -/
theorem hasBaileyValueInt_of_pair {β : ℤ} {b B N : ℕ} (hβ : β.natAbs = b) (hb : 2 ≤ b)
    (hB : 0 < B) {a : Fin N → ℚ} {x : ℝ}
    (h : HasBaileyValue b (2 * B) (N + N) (intPairCoeff β B a) x) :
    HasBaileyValueInt β B N a x := by
  subst hβ
  have hs := (summable_baileyBlockInt hb hB N a).hasSum
  have e := (hasSum_baileyBlockInt_pair hs).unique h
  rw [HasBaileyValueInt, ← e]
  exact hs

/-! ## 5. Base 2: vectors with explicit coordinates in the named patterns -/

/-- Two patterns of period 120 that agree on `0, …, 119` are equal. -/
theorem eq_of_table_120 {f g : ℕ → ℚ} (hf : ∀ k, f (k + 120) = f k)
    (hg : ∀ k, g (k + 120) = g k) (h : ∀ r < 120, f r = g r) (k : ℕ) : f k = g k := by
  rw [← mod_120 hf k, ← mod_120 hg k]
  exact h _ (Nat.mod_lt _ (by norm_num))

/-- **Length `2B`.** A vector of `P(1, 2^B, 2B, ·)` whose pattern in the class F is
`namedComb q` on one period of 120 has the value `(q₀ + q₂) π/4`. -/
theorem hasBaileyValue_F2 {B : ℕ} (hB : 0 < B) {m : ℕ} (hm : 2 * B * m = 120)
    (a : Fin (2 * B) → ℚ) (q : Fin 8 → ℚ)
    (htab : ∀ r < 120, patF2 (Nat.mul_pos two_pos hB) a r = namedComb q r) {c : ℚ}
    (hc : q 0 + q 2 = c) : HasBaileyValue 2 B (2 * B) a ((c : ℝ) * (Real.pi / 4)) := by
  have hn : 0 < 2 * B := Nat.mul_pos two_pos hB
  have hper : ∀ k, patF2 hn a (k + 120) = patF2 hn a k := fun k => by
    have h := periodic_mul (patF2_periodic hn a) m k
    rwa [hm] at h
  have h := hasSum_of_coords q (eq_of_table_120 hper (namedComb_periodic q) htab) hc
  rw [HasBaileyValue, baileyBlock_two]
  exact (hasSum_bailey_F2 hB a _).2 h

/-- **Length `B`.** A vector of `P(1, 2^B, B, ·)` whose pattern in the class F is
`namedComb q` on one period of 120 has the value `(q₀ + q₂) π/4`. -/
theorem hasBaileyValue_F1 {B : ℕ} (hB : 0 < B) {m : ℕ} (hm : 2 * B * m = 120)
    (a : Fin B → ℚ) (q : Fin 8 → ℚ)
    (htab : ∀ r < 120, patF1 hB a r = namedComb q r) {c : ℚ}
    (hc : q 0 + q 2 = c) : HasBaileyValue 2 B B a ((c : ℝ) * (Real.pi / 4)) := by
  have hper : ∀ k, patF1 hB a (k + 120) = patF1 hB a k := fun k => by
    have h := periodic_mul (patF1_periodic hB a) m k
    rwa [hm] at h
  have h := hasSum_of_coords q (eq_of_table_120 hper (namedComb_periodic q) htab) hc
  rw [HasBaileyValue, baileyBlock_two]
  exact (hasSum_bailey_F1 hB a _).2 h

/-- A combination of the eight named patterns and of `extraS2`, `extraS3`, `extraS5`. -/
def combS (q : Fin 8 → ℚ) (s : Fin 3 → ℚ) (k : ℕ) : ℚ :=
  namedComb q k + s 0 * extraS2 k + s 1 * extraS3 k + s 2 * extraS5 k

theorem combS_periodic (q : Fin 8 → ℚ) (s : Fin 3 → ℚ) (k : ℕ) :
    combS q s (k + 120) = combS q s k := by
  obtain ⟨h3, h2, h5, -, -⟩ := extra_periodic k
  simp only [combS, namedComb_periodic q k, h2, h3, h5]

/-- The value of a combination with square roots:
`(q₀ + q₂) π/4 - s₀ √2 π - s₁ π/√3 - s₂ √5 π`. -/
noncomputable def combSValue (q : Fin 8 → ℚ) (s : Fin 3 → ℚ) : ℝ :=
  ((q 0 + q 2 : ℚ) : ℝ) * (Real.pi / 4) + (s 0 : ℝ) * (-Real.sqrt 2 * Real.pi)
    + (s 1 : ℝ) * (-(Real.sqrt 3 / 3) * Real.pi) + (s 2 : ℝ) * (-Real.sqrt 5 * Real.pi)

theorem hasSum_combS (q : Fin 8 → ℚ) (s : Fin 3 → ℚ) :
    HasSum (seriesTerm (combS q s)) (combSValue q s) := by
  have h := (((hasSum_namedComb q).add (hasSum_extraS2.mul_left (s 0 : ℝ))).add
    (hasSum_extraS3.mul_left (s 1 : ℝ))).add (hasSum_extraS5.mul_left (s 2 : ℝ))
  have e : seriesTerm (combS q s) = fun k =>
      seriesTerm (namedComb q) k + (s 0 : ℝ) * seriesTerm extraS2 k
        + (s 1 : ℝ) * seriesTerm extraS3 k + (s 2 : ℝ) * seriesTerm extraS5 k := by
    funext k
    simp only [seriesTerm, combS]
    push_cast
    ring
  rw [e]
  exact h

/-- **Length `2B`, with square roots.** A vector of `P(1, 2^B, 2B, ·)` whose pattern is
`combS q s` on one period of 120 has the value `combSValue q s`. -/
theorem hasBaileyValue_F2_S {B : ℕ} (hB : 0 < B) {m : ℕ} (hm : 2 * B * m = 120)
    (a : Fin (2 * B) → ℚ) (q : Fin 8 → ℚ) (s : Fin 3 → ℚ)
    (htab : ∀ r < 120, patF2 (Nat.mul_pos two_pos hB) a r = combS q s r) :
    HasBaileyValue 2 B (2 * B) a (combSValue q s) := by
  have hn : 0 < 2 * B := Nat.mul_pos two_pos hB
  have hper : ∀ k, patF2 hn a (k + 120) = patF2 hn a k := fun k => by
    have h := periodic_mul (patF2_periodic hn a) m k
    rwa [hm] at h
  have e : patF2 hn a = combS q s :=
    funext (eq_of_table_120 hper (combS_periodic q s) htab)
  rw [HasBaileyValue, baileyBlock_two, hasSum_bailey_F2 hB, e]
  exact hasSum_combS q s

/-- **Length `B`, with square roots.** A vector of `P(1, 2^B, B, ·)` whose pattern is
`combS q s` on one period of 120 has the value `combSValue q s`. -/
theorem hasBaileyValue_F1_S {B : ℕ} (hB : 0 < B) {m : ℕ} (hm : 2 * B * m = 120)
    (a : Fin B → ℚ) (q : Fin 8 → ℚ) (s : Fin 3 → ℚ)
    (htab : ∀ r < 120, patF1 hB a r = combS q s r) :
    HasBaileyValue 2 B B a (combSValue q s) := by
  have hper : ∀ k, patF1 hB a (k + 120) = patF1 hB a k := fun k => by
    have h := periodic_mul (patF1_periodic hB a) m k
    rwa [hm] at h
  have e : patF1 hB a = combS q s :=
    funext (eq_of_table_120 hper (combS_periodic q s) htab)
  rw [HasBaileyValue, baileyBlock_two, hasSum_bailey_F1 hB, e]
  exact hasSum_combS q s

/-! ## 6. Series of step 1 and logarithms -/

/-- `∑_{k ≥ 1} x^k / k = -log (1 - x)` for `|x| < 1`; the term at `k = 0` is `0`. -/
theorem hasSum_pow_div {x : ℝ} (hx : |x| < 1) :
    HasSum (fun k : ℕ => x ^ k / (k : ℝ)) (-Real.log (1 - x)) := by
  rw [← hasSum_nat_add_iff' 1]
  simpa using Real.hasSum_pow_div_log_of_abs_lt_one hx

/-- `-(1/d) log (1 - b^(-d))`: the value of `∑_{d ∣ k} b^(-k) / k`. -/
noncomputable def logTerm (b d : ℕ) : ℝ :=
  -(1 / (d : ℝ)) * Real.log (1 - (1 / (b : ℝ)) ^ d)

theorem hasSum_logTerm {b : ℕ} (hb : 2 ≤ b) {d : ℕ} (hd : 0 < d) :
    HasSum (fun k : ℕ => if d ∣ k then (1 / (b : ℝ)) ^ k / (k : ℝ) else 0) (logTerm b d) := by
  have hb' : (2 : ℝ) ≤ (b : ℝ) := by exact_mod_cast hb
  have hx0 : 0 ≤ (1 / (b : ℝ)) ^ d := by positivity
  have hx1 : (1 / (b : ℝ)) ^ d < 1 :=
    pow_lt_one₀ (by positivity) (by rw [div_lt_one (by linarith)]; linarith) hd.ne'
  have h := (hasSum_pow_div (x := (1 / (b : ℝ)) ^ d)
    (by rw [abs_of_nonneg hx0]; exact hx1)).mul_left (1 / (d : ℝ))
  rw [← hasSum_mul_left_iff hd (fun k hk => ite_eq_right hk)]
  have e : (fun k : ℕ => if d ∣ d * k then (1 / (b : ℝ)) ^ (d * k) / ((d * k : ℕ) : ℝ)
      else 0) = fun k : ℕ => 1 / (d : ℝ) * (((1 / (b : ℝ)) ^ d) ^ k / (k : ℝ)) := by
    funext k
    rw [ite_eq_left (dvd_mul_right d k), pow_mul]
    push_cast
    ring
  rw [e, logTerm]
  convert h using 1
  ring

/-- The pattern `g(k) = ∑ c_d [d ∣ k]` over the pairs `(d, c_d)` of a list. -/
def listPat (L : List (ℕ × ℚ)) (k : ℕ) : ℚ := (L.map fun p => if p.1 ∣ k then p.2 else 0).sum

/-- The value `∑ c_d · (-(1/d) log (1 - b^(-d)))` over the pairs `(d, c_d)` of a list. -/
noncomputable def listVal (b : ℕ) (L : List (ℕ × ℚ)) : ℝ :=
  (L.map fun p => (p.2 : ℝ) * logTerm b p.1).sum

theorem listVal_nil (b : ℕ) : listVal b [] = 0 := rfl

theorem listVal_cons (b d : ℕ) (c : ℚ) (L : List (ℕ × ℚ)) :
    listVal b ((d, c) :: L) = (c : ℝ) * logTerm b d + listVal b L := rfl

theorem listPat_periodic {N : ℕ} (L : List (ℕ × ℚ)) (hL : ∀ p ∈ L, p.1 ∣ N) (k : ℕ) :
    listPat L (k + N) = listPat L k := by
  unfold listPat
  congr 1
  refine List.map_congr_left fun p hp => ?_
  have e : p.1 ∣ k + N ↔ p.1 ∣ k := (Nat.dvd_add_iff_left (hL p hp)).symm
  simp only [e]

theorem hasSum_listPat {b : ℕ} (hb : 2 ≤ b) (L : List (ℕ × ℚ)) (hL : ∀ p ∈ L, 0 < p.1) :
    HasSum (fun k : ℕ => (listPat L k : ℝ) / (b : ℝ) ^ k / (k : ℝ)) (listVal b L) := by
  induction L with
  | nil =>
    simp only [listPat, listVal, List.map_nil, List.sum_nil, Rat.cast_zero, zero_div]
    exact hasSum_zero
  | cons p L ih =>
    have h1 := (hasSum_logTerm hb (hL p List.mem_cons_self)).mul_left (p.2 : ℝ)
    have h := h1.add (ih fun q hq => hL q (List.mem_cons_of_mem _ hq))
    have e : (fun k : ℕ => (listPat (p :: L) k : ℝ) / (b : ℝ) ^ k / (k : ℝ)) = fun k : ℕ =>
        (p.2 : ℝ) * (if p.1 ∣ k then (1 / (b : ℝ)) ^ k / (k : ℝ) else 0)
          + (listPat L k : ℝ) / (b : ℝ) ^ k / (k : ℝ) := by
      funext k
      simp only [listPat, List.map_cons, List.sum_cons, one_div_pow]
      split_ifs <;> push_cast <;> ring
    rw [e]
    exact h

/-- **A series of step 1 with a pattern supported by divisors.** For a list `L` of pairs
`(d, c_d)` with `d ∣ N`, the vector `a_i = g(i) / b^i` with `g(k) = ∑ c_d [d ∣ k]` gives
`P(1, b^N, N, a) = ∑ c_d · (-(1/d) log (1 - b^(-d)))`. -/
theorem hasBaileyValue_step_one {b N : ℕ} (hb : 2 ≤ b) (hN : 0 < N) (L : List (ℕ × ℚ))
    (hL : ∀ p ∈ L, 0 < p.1 ∧ p.1 ∣ N) :
    HasBaileyValue b N N (fun i => listPat L ((i : ℕ) + 1) / (b : ℚ) ^ ((i : ℕ) + 1))
      (listVal b L) :=
  hasSum_baileyBlock_step_one b hN (listPat_periodic L fun p hp => (hL p hp).2)
    (hasSum_listPat hb L fun p hp => (hL p hp).1)

/-- `-(1/d) log (1 - b^(-d)) = log b - (log m) / d` with `m = b^d - 1`. -/
theorem logTerm_eq {b d : ℕ} {m : ℝ} (hb : 2 ≤ b) (hd : 0 < d) (hm : (b : ℝ) ^ d = m + 1) :
    logTerm b d = Real.log b - Real.log m / d := by
  have hb' : (2 : ℝ) ≤ (b : ℝ) := by exact_mod_cast hb
  have hb0 : (0 : ℝ) < (b : ℝ) := by linarith
  have hbd : (1 : ℝ) < (b : ℝ) ^ d := one_lt_pow₀ (by linarith) hd.ne'
  have hm0 : 0 < m := by linarith
  have hd0 : (d : ℝ) ≠ 0 := by positivity
  have e : 1 - (1 / (b : ℝ)) ^ d = m / (b : ℝ) ^ d := by
    rw [one_div_pow, eq_div_iff (by positivity), hm]
    field_simp
    ring
  rw [logTerm, e, Real.log_div hm0.ne' (by positivity), Real.log_pow]
  field_simp
  ring

