import Pilean.Base3.PiValue

/-!
# Base 3: building a good prime for a root of unity

`HasPrime p x`: some prime ideal of the algebraic integers contains the rational prime `p`
and the algebraic integer `x`.

* `hasPrime_of_not_unit` (lying over): if `1` is not in the ideal `(p, F(ζ))` of `ℤ[ζ]`, then
  `HasPrime p (F(ζ))`.
* `hasPrime_conj`: for a primitive `N`-th root of unity `ζ` and `a` prime to `N`,
  `HasPrime p (F(ζ^a))` implies `HasPrime p (F(ζ))`. No automorphism of ideals is used: an
  identity `U(ζ) p + V(ζ) F(ζ) = 1` is an integer polynomial identity at `ζ`, so it holds at
  `ζ^a` (`aeval_pow_of_coprime`).
* `hasPrime_of_dvd_norm`: if `p` divides the integer `|F(ζ)|^2`, then `HasPrime p (F(ζ))`.
* `goodPrime_of_coset`: **the reduction.** Let `r` have order `M`, `E = M / gcd(M, 6)`, and
  let `p ≥ 5` be a prime with `p ∤ M` whose order `n` of 3 satisfies `n h = 2M` for some
  `h ∣ 8`. If `HasPrime p (t^E - r^E)`, then `r` has a good prime. Indeed
  `t^E - r^E = ∏_j (t - r^(1 + g j))`, so the prime contains some `t - r^a`; the order of 3
  forces `a` to be prime to `M`; and `r^a` is conjugate to `r` over `ℚ(ω)`.
-/

open Complex Polynomial

namespace PiFormula

namespace Base3

/-- Some prime ideal of the algebraic integers contains `p` and `x`. -/
def HasPrime (p : ℕ) (x : ℂ) : Prop :=
  ∃ Q : Ideal Aint, Q.IsPrime ∧ InP Q (p : ℂ) ∧ InP Q x

theorem isIntegral_aeval {z : ℂ} (hz : IsIntegral ℤ z) (G : ℤ[X]) : IsIntegral ℤ (aeval z G) := by
  have h := Subalgebra.aeval_coe (integralClosure ℤ ℂ) (⟨z, hz⟩ : Aint) G
  have h2 : aeval z G = ((aeval (⟨z, hz⟩ : Aint) G : Aint) : ℂ) := h
  rw [h2]
  exact (aeval (⟨z, hz⟩ : Aint) G).2

/-- **Lying over.** If no `U, V ∈ ℤ[X]` satisfy `U(ζ) p + V(ζ) F(ζ) = 1`, then some prime ideal
of the algebraic integers contains `p` and `F(ζ)`. -/
theorem hasPrime_of_not_unit {ζ : ℂ} (hζ : IsIntegral ℤ ζ) (p : ℕ) (F : ℤ[X])
    (h : ∀ U V : ℤ[X], aeval ζ (U * C (p : ℤ) + V * F) ≠ 1) : HasPrime p (aeval ζ F) := by
  let φ : ℤ[X] →+* Aint := Polynomial.eval₂RingHom (algebraMap ℤ Aint) ⟨ζ, hζ⟩
  have hφ : ∀ g : ℤ[X], ((φ g : Aint) : ℂ) = aeval ζ g := by
    intro g
    have h1 := Polynomial.hom_eval₂ g (algebraMap ℤ Aint) (Aint.val : Aint →+* ℂ) ⟨ζ, hζ⟩
    have h2 : (Aint.val : Aint →+* ℂ).comp (algebraMap ℤ Aint) = algebraMap ℤ ℂ :=
      RingHom.ext_int _ _
    rw [h2] at h1
    rw [aeval_def]
    exact h1
  let _ : Algebra ℤ[X] Aint := φ.toAlgebra
  have halg : ∀ g : ℤ[X], algebraMap ℤ[X] Aint g = φ g := fun _ => rfl
  have : Algebra.IsIntegral ℤ[X] Aint := by
    refine ⟨fun x => ?_⟩
    obtain ⟨q, hq, hq0⟩ := integralClosure.isIntegral (R := ℤ) (A := ℂ) x
    refine ⟨q.map (Int.castRingHom ℤ[X]), hq.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have : (algebraMap ℤ[X] Aint).comp (Int.castRingHom ℤ[X]) = algebraMap ℤ Aint :=
      RingHom.ext_int _ _
    rw [this]
    exact hq0
  -- the ideal generated by `p`, `F` and the kernel of `X ↦ ζ`
  let J : Ideal ℤ[X] := Ideal.span {C (p : ℤ), F} ⊔ RingHom.ker φ
  have hJ : J ≠ ⊤ := by
    intro htop
    have h1 : (1 : ℤ[X]) ∈ J := by rw [htop]; trivial
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 h1
    obtain ⟨U, V, rfl⟩ := Ideal.mem_span_pair.1 ha
    apply h U V
    have hb0 : aeval ζ b = 0 := by
      rw [← hφ b, RingHom.mem_ker.1 hb]
      rfl
    have h2 := congrArg (aeval ζ) hab
    rw [map_add, hb0, add_zero, map_one] at h2
    exact h2
  obtain ⟨𝔪, h𝔪, hJ𝔪⟩ := Ideal.exists_le_maximal J hJ
  have : 𝔪.IsPrime := h𝔪.isPrime
  obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral 𝔪 (⊥ : Ideal Aint) (by
    intro g hg
    rw [Ideal.mem_under, Ideal.mem_bot, halg] at hg
    exact hJ𝔪 (Ideal.mem_sup_right (RingHom.mem_ker.2 hg)))
  have key : ∀ g : ℤ[X], g ∈ 𝔪 → InP Q (aeval ζ g) := by
    intro g hg
    have hgQ : φ g ∈ Q := by
      have h1 : g ∈ Q.under ℤ[X] := by rw [hQP]; exact hg
      rw [Ideal.mem_under, halg] at h1
      exact h1
    refine ⟨isIntegral_aeval hζ g, ?_⟩
    have e : (⟨aeval ζ g, isIntegral_aeval hζ g⟩ : Aint) = φ g := Subtype.ext (hφ g).symm
    rw [e]
    exact hgQ
  refine ⟨Q, hQ, ?_, key F (hJ𝔪 (Ideal.mem_sup_left (Ideal.subset_span (by simp))))⟩
  have h1 := key (C (p : ℤ)) (hJ𝔪 (Ideal.mem_sup_left (Ideal.subset_span (by simp))))
  simpa using h1

/-- **Conjugation.** `HasPrime p (F(ζ^a))` implies `HasPrime p (F(ζ))`, for `a` prime to the
order of `ζ`. -/
theorem hasPrime_conj {ζ : ℂ} {N : ℕ} (hN : 0 < N) (hζ : IsPrimitiveRoot ζ N) {p : ℕ}
    (F : ℤ[X]) {a : ℕ} (ha : a.Coprime N) (h : HasPrime p (aeval (ζ ^ a) F)) :
    HasPrime p (aeval ζ F) := by
  have hint : IsIntegral ℤ ζ := hζ.isIntegral hN
  apply hasPrime_of_not_unit hint
  intro U V hUV
  have h1 : aeval ζ (U * C (p : ℤ) + V * F - 1) = 0 := by
    rw [map_sub, hUV, map_one, sub_self]
  have h2 := aeval_pow_of_coprime hN hζ h1 ha
  rw [map_sub, map_one, sub_eq_zero, map_add, map_mul, map_mul, aeval_C] at h2
  obtain ⟨Q, hQ, hp, hF⟩ := h
  have hi : ∀ G : ℤ[X], IsIntegral ℤ (aeval (ζ ^ a) G) := isIntegral_aeval (hint.pow a)
  have hp' : InP Q (algebraMap ℤ ℂ (p : ℤ)) := by simpa using hp
  have h3 : InP Q 1 := by
    rw [← h2]
    exact (hp'.mul_left (hi U)).add (hF.mul_left (hi V))
  exact not_inP_one h3

theorem aeval_conj (z : ℂ) (F : ℤ[X]) :
    aeval ((starRingEnd ℂ) z) F = (starRingEnd ℂ) (aeval z F) := by
  have h1 := Polynomial.hom_eval₂ F (algebraMap ℤ ℂ) (starRingEnd ℂ) z
  have h2 : (starRingEnd ℂ).comp (algebraMap ℤ ℂ) = algebraMap ℤ ℂ := RingHom.ext_int _ _
  rw [h2] at h1
  rw [aeval_def, aeval_def]
  exact h1.symm

theorem coprime_pred_self {N : ℕ} (hN : 0 < N) : Nat.Coprime (N - 1) N := by
  obtain ⟨m, rfl⟩ : ∃ m, N = m + 1 := ⟨N - 1, by omega⟩
  simp

/-- **From the norm.** If `p` divides the integer `|F(ζ)|^2`, some prime ideal contains `p` and
`F(ζ)`. -/
theorem hasPrime_of_dvd_norm {ζ : ℂ} {N : ℕ} (hN : 0 < N) (hζ : IsPrimitiveRoot ζ N) {p : ℕ}
    (hp : p.Prime) (F : ℤ[X]) {D : ℤ} (hD : (p : ℤ) ∣ D)
    (hnorm : ((D : ℤ) : ℝ) = ‖aeval ζ F‖ ^ 2) : HasPrime p (aeval ζ F) := by
  obtain ⟨Q, hQ, hpQ⟩ := exists_prime_above hp
  have hint : IsIntegral ℤ ζ := hζ.isIntegral hN
  have hx : IsIntegral ℤ (aeval ζ F) := isIntegral_aeval hint F
  -- the conjugate of `ζ` is `ζ^(N-1)`
  have hζ1 : ‖ζ‖ = 1 := hζ.norm'_eq_one hN.ne'
  have hconjζ : (starRingEnd ℂ) ζ = ζ ^ (N - 1) := by
    rw [← Complex.inv_eq_conj hζ1]
    apply inv_eq_of_mul_eq_one_right
    rw [← pow_succ', Nat.sub_add_cancel hN, hζ.pow_eq_one]
  have hconj : (starRingEnd ℂ) (aeval ζ F) = aeval (ζ ^ (N - 1)) F := by
    rw [← aeval_conj, hconjζ]
  have hxc : IsIntegral ℤ ((starRingEnd ℂ) (aeval ζ F)) := by
    rw [hconj]
    exact isIntegral_aeval (hint.pow _) F
  have hprod : ((D : ℤ) : ℂ) = aeval ζ F * (starRingEnd ℂ) (aeval ζ F) := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
    exact_mod_cast congrArg (fun x : ℝ => (x : ℂ)) hnorm
  obtain ⟨k, rfl⟩ := hD
  have hDQ : InP Q (((p : ℤ) * k : ℤ) : ℂ) := by
    have := hpQ.mul_right (isIntegral_intCast k)
    push_cast
    exact this
  rw [hprod] at hDQ
  rcases inP_mul hx hxc hDQ with h | h
  · exact ⟨Q, hQ, hpQ, h⟩
  · refine hasPrime_conj hN hζ F (coprime_pred_self hN) ⟨Q, hQ, hpQ, ?_⟩
    rwa [← hconj]

/-- `ω` is a primitive cube root of unity. -/
theorem isPrimitiveRoot_w3 : IsPrimitiveRoot w3 3 := by
  have h := zetaN_prim (N := 3) (by norm_num)
  have e : zetaN 3 = w3 := by
    have := zetaN_pow_third (K := 1) one_pos
    simpa using this
  rwa [e] at h

/-! ## The reduction -/

/-- **A good prime from a prime of the coset.** -/
theorem goodPrime_of_coset {r : ℂ} (hr : IsOfFinOrder r) {E : ℕ} (hE : 0 < E)
    (hgE : Nat.gcd (orderOf r) 6 * E = orderOf r) {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hpM : ¬ p ∣ orderOf r) {h : ℕ} (h8 : h ∣ 8)
    (hn : orderOf (3 : ZMod p) * h = 2 * orderOf r)
    (hQ : HasPrime p (t3 ^ E - r ^ E)) : HasGoodPrime3 r := by
  classical
  obtain ⟨M, hMdef⟩ : ∃ M, orderOf r = M := ⟨_, rfl⟩
  rw [hMdef] at hgE hpM hn
  have hM0 : 0 < M := hMdef ▸ hr.orderOf_pos
  obtain ⟨g, hgdef⟩ : ∃ g, Nat.gcd M 6 = g := ⟨_, rfl⟩
  rw [hgdef] at hgE
  obtain ⟨Q, hQp, hpQ, hxQ⟩ := hQ
  have hrM : r ^ M = 1 := hMdef ▸ pow_orderOf_eq_one r
  -- `r^g` is a primitive `E`-th root of unity
  have hu : IsPrimitiveRoot (r ^ g) E := by
    have h0 : IsPrimitiveRoot r M := hMdef ▸ IsPrimitiveRoot.orderOf r
    exact h0.pow hM0 hgE.symm
  -- `t^E - r^E = ∏ (t - (r^g)^j r)`
  have hprod : t3 ^ E - r ^ E = ∏ j ∈ Finset.range E, (t3 - (r ^ g) ^ j * r) := by
    have h1 := prod_sub_nthRoots hE (r ^ E) t3
    rw [hu.nthRoots_eq rfl, Multiset.map_map] at h1
    exact h1.symm
  rw [hprod] at hxQ
  have hroot : ∀ j : ℕ, IsOfFinOrder ((r ^ g) ^ j * r) := fun j =>
    ((hr.pow (n := g)).pow (n := j)).mul hr
  obtain ⟨j, -, hjQ⟩ := inP_prod (Finset.range E) _
    (fun j _ => isIntegral_t3_sub (hroot j)) hxQ
  obtain ⟨a, hadef⟩ : ∃ a, a = g * j + 1 := ⟨_, rfl⟩
  have hs : (r ^ g) ^ j * r = r ^ a := by rw [hadef, ← pow_mul, ← pow_succ]
  rw [hs] at hjQ
  -- the exponent `a` is prime to `M`
  have hk1 : Nat.gcd M a = 1 := by
    obtain ⟨k, hk⟩ : ∃ k, Nat.gcd M a = k := ⟨_, rfl⟩
    rw [hk]
    have hkM : k ∣ M := hk ▸ Nat.gcd_dvd_left _ _
    have hka : k ∣ a := hk ▸ Nat.gcd_dvd_right _ _
    have hk6 : Nat.Coprime k 6 := by
      have h1 : Nat.gcd k 6 ∣ g :=
        hgdef ▸ Nat.dvd_gcd ((Nat.gcd_dvd_left k 6).trans hkM) (Nat.gcd_dvd_right k 6)
      have h2 : Nat.gcd k 6 ∣ g * j + 1 := hadef ▸ (Nat.gcd_dvd_left k 6).trans hka
      have h3 : Nat.gcd k 6 ∣ g * j := Dvd.dvd.mul_right h1 j
      exact Nat.dvd_one.1 ((Nat.dvd_add_right h3).1 h2)
    obtain ⟨M', hM'⟩ := hkM
    obtain ⟨a', ha'⟩ := hka
    have hM'0 : 0 < M' := Nat.pos_of_ne_zero (by rintro rfl; omega)
    -- `(r^a)^M' = 1`
    have hsM' : (r ^ a) ^ M' = 1 := by
      rw [← pow_mul, ha', show k * a' * M' = k * M' * a' by ring, ← hM', pow_mul, hrM, one_pow]
    -- `t^M' - 1 ∈ Q`
    have hrint : IsIntegral ℤ (r ^ a) := (isIntegral_of_finOrder hr).pow a
    have h1 : InP Q (t3 ^ M' - 1) := by
      have e := (Commute.all t3 (r ^ a)).mul_geom_sum₂ M'
      rw [hsM'] at e
      rw [← e]
      exact hjQ.mul_right (IsIntegral.sum _ fun i _ =>
        (isIntegral_t3.pow _).mul (hrint.pow _))
    -- `3^(2M') - 1 ∈ Q`
    have h2 : InP Q (((3 ^ (2 * M') - 1 : ℕ) : ℂ)) := by
      have e : (((3 ^ (2 * M') - 1 : ℕ)) : ℂ) =
          (t3 ^ M' - 1) * ((t3 ^ M') ^ 3 + (t3 ^ M') ^ 2 + t3 ^ M' + 1) := by
        have h4 : (t3 ^ M') ^ 4 = (3 : ℂ) ^ (2 * M') := by
          rw [← pow_mul, show M' * 4 = 2 * (2 * M') by ring, pow_mul, t3_sq,
            show ((-3 : ℂ)) ^ (2 * M') = ((-3 : ℂ) ^ 2) ^ M' by rw [← pow_mul],
            show ((3 : ℂ)) ^ (2 * M') = ((3 : ℂ) ^ 2) ^ M' by rw [← pow_mul]]
          norm_num
        rw [Nat.cast_sub (Nat.one_le_pow _ _ (by norm_num))]
        push_cast
        rw [← h4]
        ring
      rw [e]
      have hi := isIntegral_t3.pow M'
      exact h1.mul_right ((((hi.pow 3).add (hi.pow 2)).add hi).add isIntegral_one)
    -- `p ∣ 3^(2M') - 1`
    have h3 : p ∣ 3 ^ (2 * M') - 1 := by
      by_contra hnd
      exact not_inP_coprime ((Nat.Prime.coprime_iff_not_dvd hp).2 hnd).symm h2 hpQ
    have h4 : orderOf (3 : ZMod p) ∣ 2 * M' := by
      apply orderOf_dvd_of_pow_eq_one
      have h5 : ((3 ^ (2 * M') - 1 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 h3
      rw [Nat.cast_sub (Nat.one_le_pow _ _ (by norm_num))] at h5
      push_cast at h5
      exact sub_eq_zero.1 h5
    obtain ⟨q, hq⟩ := h4
    have hn0 : 0 < orderOf (3 : ZMod p) := by
      rcases Nat.eq_zero_or_pos (orderOf (3 : ZMod p)) with h0 | h0
      · rw [h0, zero_mul] at hn
        omega
      · exact h0
    have h5 : k ∣ h := by
      refine ⟨q, Nat.eq_of_mul_eq_mul_left hn0 ?_⟩
      rw [hn, hM', show orderOf (3 : ZMod p) * (k * q) = k * (orderOf (3 : ZMod p) * q) by ring,
        ← hq]
      ring
    have h6 : k ∣ 8 := h5.trans h8
    have h7 : k ≤ 8 := Nat.le_of_dvd (by norm_num) h6
    have hk0 : 0 < k := Nat.pos_of_ne_zero (by rintro rfl; simp at hM'; omega)
    interval_cases k <;>
      first | rfl | exact absurd hk6 (by decide) | exact absurd h6 (by decide)
  -- an exponent `a' ≡ a (mod M)`, `a' ≡ 1 (mod 3)`, prime to `3M`
  obtain ⟨a', ha'M, ha'3, ha'c⟩ :
      ∃ a' : ℕ, a' ≡ a [MOD M] ∧ a' % 3 = 1 ∧ a'.Coprime (3 * M) := by
    have hcopM : Nat.Coprime a M := Nat.coprime_comm.1 hk1
    by_cases h3 : 3 ∣ M
    · have h3g : 3 ∣ g := hgdef ▸ Nat.dvd_gcd h3 (by norm_num)
      obtain ⟨g', hg'⟩ := h3g
      have ha3 : a % 3 = 1 := by
        rw [hadef, hg', show 3 * g' * j + 1 = 1 + 3 * (g' * j) by ring, Nat.add_mul_mod_self_left]
      refine ⟨a, Nat.ModEq.refl _, ha3, ?_⟩
      have hc3 : Nat.Coprime a 3 := by
        rw [Nat.Coprime, Nat.gcd_comm, Nat.gcd_rec, ha3]
        rfl
      exact Nat.Coprime.mul_right hc3 hcopM
    · have hc : Nat.Coprime M 3 := ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 h3).symm
      let x := Nat.chineseRemainder hc a 1
      have hx3 : x.1 % 3 = 1 := x.2.2
      refine ⟨x.1, x.2.1, hx3, ?_⟩
      have hc3 : Nat.Coprime x.1 3 := by
        rw [Nat.Coprime, Nat.gcd_comm, Nat.gcd_rec, hx3]
        rfl
      have hcM : Nat.Coprime x.1 M := by
        rw [Nat.Coprime, x.2.1.gcd_eq]
        exact hcopM
      exact Nat.Coprime.mul_right hc3 hcM
  have hra : r ^ a' = r ^ a := by
    rw [← pow_mod_orderOf r a', ← pow_mod_orderOf r a, hMdef, show a' % M = a % M from ha'M]
  -- conjugate back to `r`
  have hN0 : 0 < 3 * M := by positivity
  have hζ := zetaN_prim hN0
  have hζM : zetaN (3 * M) ^ M = w3 := zetaN_pow_third hM0
  have : NeZero (3 * M) := ⟨hN0.ne'⟩
  obtain ⟨k₀, -, hk₀⟩ := hζ.eq_pow_of_pow_eq_one
    (show r ^ (3 * M) = 1 by rw [mul_comm, pow_mul, hrM, one_pow])
  let F : ℤ[X] := X ^ M - X ^ (2 * M) - X ^ k₀
  have hF : ∀ z : ℂ, aeval z F = z ^ M - z ^ (2 * M) - z ^ k₀ := fun z => by simp [F]
  have hF1 : aeval (zetaN (3 * M)) F = t3 - r := by
    rw [hF, mul_comm 2 M, pow_mul, hζM, hk₀, ← t3_eq]
  have hF2 : aeval (zetaN (3 * M) ^ a') F = t3 - r ^ a' := by
    have e1 : (zetaN (3 * M) ^ a') ^ M = w3 := by
      rw [← pow_mul, mul_comm a' M, pow_mul, hζM, w3_pow_of_mod_three ha'3]
    have e2 : (zetaN (3 * M) ^ a') ^ (2 * M) = w3 ^ 2 := by rw [mul_comm 2 M, pow_mul, e1]
    have e3 : (zetaN (3 * M) ^ a') ^ k₀ = r ^ a' := by
      rw [← pow_mul, mul_comm a' k₀, pow_mul, hk₀]
    rw [hF, e1, e2, e3, ← t3_eq]
  have hfinal : HasPrime p (t3 - r) := by
    rw [← hF1]
    refine hasPrime_conj hN0 hζ F ha'c ?_
    rw [hF2, hra]
    exact ⟨Q, hQp, hpQ, hjQ⟩
  obtain ⟨Q', hQ', hpQ', hrQ'⟩ := hfinal
  exact ⟨Q', hQ', p, hp, hp5, by rw [hMdef]; exact hpM, hpQ', hrQ'⟩

end Base3

end PiFormula
